---
import { Image } from 'astro:assets';
import type { CatalogueItem } from '../data/catalogue';
import {
  imageFor,
  itemPath,
  itemSlug,
  itemFacts,
  searchText,
  placeOf,
  materialTokens,
  enquiryAttrs,
  sortCapacity,
} from '../lib/catalogue';

// One catalogue card. The whole card is a link to the item's own page, and
// under it one action: add the item to the enquiry list (or take it off
// again). On pointer devices, hovering the photo lifts a spec peek over it;
// on touch there is no hover and the tap goes straight to the page, which is
// where the same facts live in full. No modal: for spec-driven items a
// quick-view overlay gets mistaken for the real page.
//
// The add button keeps its space from the first paint but stays invisible
// (data-enq-pending) until the enquiry list's script arms it
// (src/components/EnquiryTray.astro). It used to ship `hidden`, and every
// card grew when it appeared, moving the rows below it. Without JS the
// catalogue's <noscript> style removes it, so there is no dead button; the
// item page's own email and WhatsApp links still work.

interface Props {
  item: CatalogueItem;
}

const { item } = Astro.props;
const path = itemPath(item);
const facts = itemFacts(item);
// The peek is a glance, not the datasheet: the first few facts only.
const peek = facts.filter((f) => f.label !== 'Colour').slice(0, 5);
const place = placeOf(item);
const enq = await enquiryAttrs(item, Astro.site);
---

<li
  class="cat-item"
  data-cat-item
  data-slug={itemSlug(item)}
  data-line={place.line.id}
  data-group={place.group.id}
  data-type={place.type?.id ?? ''}
  data-mat={materialTokens(item).join(' ')}
  data-cap={sortCapacity(item) ?? ''}
  data-search={searchText(item)}
>
  <a href={path} class="cat-card">
    <figure class="relative m-0 flex aspect-square items-center justify-center overflow-hidden rounded-sm border border-line bg-white p-3 md:p-4">
      {
        item.illustrative ? (
          <img
            src={imageFor(item.image).src}
            alt={`${item.name}, representative illustration`}
            class="h-full w-full scale-[1.32] object-contain"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            src={imageFor(item.image)}
            alt={item.name}
            width={360}
            densities={[1, 2]}
            format="webp"
            quality={80}
            class="h-full w-full object-contain"
            loading="lazy"
          />
        )
      }
      {
        peek.length > 0 && (
          <dl class="cat-peek" aria-hidden="true">
            {peek.map((f) => (
              <div class="cat-peek-row">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </figure>
    <p class="mt-2.5 text-[13px] leading-snug font-semibold text-ink md:text-sm">{item.name}</p>
    {
      (item.material || item.weight) && (
        <p class="mt-1 text-xs text-steel-deep">{[item.material, item.weight].filter(Boolean).join(' · ')}</p>
      )
    }
  </a>
  <button
    type="button"
    class="enq-add mt-2"
    data-enq-add
    {...enq}
    aria-pressed="false"
    aria-label={`Add ${item.name} to the enquiry list`}
    data-enq-pending
  >
    <svg class="enq-add-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path class="enq-add-plus" d="M12 5v14M5 12h14" stroke-linecap="round" />
      <path class="enq-add-tick" d="m5 12.5 4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="enq-add-off">Add to enquiry</span>
    <span class="enq-add-on">Added</span>
  </button>
</li>

<style>
  .cat-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .cat-card figure {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cat-card:hover figure,
  .cat-card:focus-visible figure {
    border-color: var(--color-steel);
    box-shadow: 0 10px 24px -16px rgba(38, 48, 61, 0.45);
  }
  .cat-card:focus-visible {
    outline: none;
  }

  /* The spec peek: a white sheet rising over the photo with the item's key
     facts. Pointer devices only; on touch it never renders, the tap opens
     the item page instead. */
  .cat-peek {
    display: none;
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 0.7rem 0.8rem 0.75rem;
    background: rgba(255, 255, 255, 0.96);
    border-top: 1px solid var(--color-line);
    font-size: 0.75rem;
    line-height: 1.35;
    transform: translateY(8px);
    opacity: 0;
    transition: opacity 0.18s ease, transform 0.22s ease;
  }
  @media (hover: hover) and (min-width: 640px) {
    .cat-peek {
      display: block;
    }
    .cat-card:hover .cat-peek,
    .cat-card:focus-visible .cat-peek {
      opacity: 1;
      transform: none;
    }
  }
  .cat-peek-row {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.15rem 0;
  }
  .cat-peek-row + .cat-peek-row {
    border-top: 1px solid var(--color-paper-warm);
  }
  .cat-peek dt {
    color: var(--color-steel-deep);
    white-space: nowrap;
  }
  .cat-peek dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: 600;
    text-align: right;
  }

  /* The card grows to fill its grid row, so every add button in a row sits
     on the same line however long the item name runs. */
  .cat-item {
    display: flex;
    flex-direction: column;
  }
  .cat-card {
    flex: 1 0 auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-card figure,
    .cat-peek {
      transition: none;
    }
  }
</style>
