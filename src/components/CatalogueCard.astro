---
import { Image } from 'astro:assets';
import type { CatalogueItem } from '../data/catalogue';
import Formula from './Formula.astro';
import {
  imageFor,
  itemPath,
  itemSlug,
  itemFacts,
  itemDetail,
  specValue,
  searchText,
  placeOf,
  materialTokens,
  enquiryAttrs,
  sortCapacity,
} from '../lib/catalogue';

// One catalogue card. The whole card is a link to the item's own page, and
// under it one action: add the item to the enquiry list (or take it off
// again). On pointer devices, hovering the photo lifts a spec peek over it;
// on touch there is no hover and the tap goes straight to the page, which is
// where the same facts live in full. No modal: for spec-driven items a
// quick-view overlay gets mistaken for the real page.
//
// The add button keeps its space from the first paint but stays invisible
// (data-enq-pending) until the enquiry list's script arms it
// (src/components/EnquiryTray.astro). It used to ship `hidden`, and every
// card grew when it appeared, moving the rows below it. Without JS the
// catalogue's <noscript> style removes it, so there is no dead button; the
// item page's own email and WhatsApp links still work.

interface Props {
  item: CatalogueItem;
}

const { item } = Astro.props;
const path = itemPath(item);
const facts = itemFacts(item);
// The peek is a glance, not the datasheet: the first few facts only. For an
// API that is CAS, formula and weight under short labels (the UNII and a
// mixture's composition stay on the item page); "Molecular formula" beside
// "C63H91CoN13O14P" does not fit a card.
const PEEK_LABELS: Record<string, string> = {
  'CAS number': 'CAS',
  'Molecular formula': 'Formula',
  'Molecular weight': 'Mol. weight',
};
const peek = item.structure
  ? facts.filter((f) => PEEK_LABELS[f.label]).map((f) => ({ label: PEEK_LABELS[f.label], value: f.value }))
  : facts.filter((f) => f.label !== 'Colour').slice(0, 5);
const place = placeOf(item);
const enq = await enquiryAttrs(item, Astro.site);
const detail = itemDetail(item);
// API tiles: the structure drawing fills the square on its own colour, with
// the class (the filter's own short name) top left and the formula bottom
// left, both in the tile's ink, which render.mjs holds to 7:1 on its tint.
const tone = item.structure ? item.tone : undefined;
const formula = item.structure ? specValue(item, 'Molecular formula') : undefined;
// Molecular weight as a number, for the API sorts ("392.46 g/mol" -> 392.46).
const mw = parseFloat(specValue(item, 'Molecular weight') ?? '');
const classLabel = place.type?.short ?? place.group.name;
---

<li
  class="cat-item"
  data-cat-item
  data-slug={itemSlug(item)}
  data-line={place.line.id}
  data-group={place.group.id}
  data-type={place.type?.id ?? ''}
  data-mat={materialTokens(item).join(' ')}
  data-cap={sortCapacity(item) ?? ''}
  data-mw={Number.isFinite(mw) ? mw : ''}
  data-search={searchText(item)}
>
  <a href={path} class="cat-card">
    <figure
      class:list={[
        'relative m-0 flex aspect-square items-center justify-center overflow-hidden rounded-sm border',
        tone ? 'cat-tile' : 'border-line bg-white p-3 md:p-4',
      ]}
      style={tone ? `--tile-bg:${tone.bg};--tile-ink:${tone.ink};--tile-mid:${tone.mid}` : undefined}
    >
      {
        tone ? (
          <>
            <img
              src={imageFor(item.image).src}
              alt={`${item.name}, structural formula`}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="tile-class">{classLabel}</span>
            {formula && (
              <span class="tile-formula">
                <Formula value={formula} />
              </span>
            )}
          </>
        ) : item.illustrative ? (
          <img
            src={imageFor(item.image).src}
            alt={`${item.name}, representative illustration`}
            class="h-full w-full scale-[1.32] object-contain"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            src={imageFor(item.image)}
            alt={item.name}
            width={360}
            densities={[1, 2]}
            format="webp"
            quality={80}
            class="h-full w-full object-contain"
            loading="lazy"
          />
        )
      }
      {
        peek.length > 0 && (
          <dl class="cat-peek" aria-hidden="true">
            {peek.map((f) => (
              <div class="cat-peek-row">
                <dt>{f.label}</dt>
                <dd>{f.label === 'Formula' ? <Formula value={f.value} /> : f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </figure>
    <p class="mt-2.5 text-[13px] leading-snug font-semibold text-ink md:text-sm">{item.name}</p>
    {detail && <p class="mt-1 text-xs text-steel-deep">{detail}</p>}
  </a>
  <button
    type="button"
    class="enq-add mt-2"
    data-enq-add
    {...enq}
    aria-pressed="false"
    aria-label={`Add ${item.name} to the enquiry list`}
    data-enq-pending
  >
    <svg class="enq-add-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path class="enq-add-plus" d="M12 5v14M5 12h14" stroke-linecap="round" />
      <path class="enq-add-tick" d="m5 12.5 4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="enq-add-off">Add to enquiry</span>
    <span class="enq-add-on">Added</span>
  </button>
</li>

<style>
  .cat-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .cat-card figure {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cat-card:hover figure,
  .cat-card:focus-visible figure {
    border-color: var(--color-steel);
    box-shadow: 0 10px 24px -16px rgba(38, 48, 61, 0.45);
  }
  .cat-card:focus-visible {
    outline: none;
  }

  /* An API's structure tile. The border is a darker step of its own colour
     rather than the grey hairline, so a row of tiles reads as colour, not as
     boxes; the class and formula sit on the tile in its ink. */
  .cat-tile {
    background: var(--tile-bg);
    border-color: color-mix(in srgb, var(--tile-mid) 55%, var(--tile-bg));
  }
  .tile-class,
  .tile-formula {
    position: absolute;
    left: 0.6rem;
    color: var(--tile-ink);
    line-height: 1.2;
    pointer-events: none;
  }
  .tile-class {
    top: 0.55rem;
    right: 0.6rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tile-formula {
    bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  @media (min-width: 768px) {
    .tile-class,
    .tile-formula {
      left: 0.75rem;
    }
    .tile-class {
      top: 0.7rem;
    }
    .tile-formula {
      bottom: 0.65rem;
      font-size: 0.8125rem;
    }
  }

  /* The spec peek: a white sheet rising over the photo with the item's key
     facts. Pointer devices only; on touch it never renders, the tap opens
     the item page instead. */
  .cat-peek {
    display: none;
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 0.7rem 0.8rem 0.75rem;
    background: rgba(255, 255, 255, 0.96);
    border-top: 1px solid var(--color-line);
    font-size: 0.75rem;
    line-height: 1.35;
    transform: translateY(8px);
    opacity: 0;
    transition: opacity 0.18s ease, transform 0.22s ease;
  }
  @media (hover: hover) and (min-width: 640px) {
    .cat-peek {
      display: block;
    }
    .cat-card:hover .cat-peek,
    .cat-card:focus-visible .cat-peek {
      opacity: 1;
      transform: none;
    }
  }
  .cat-peek-row {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.15rem 0;
  }
  .cat-peek-row + .cat-peek-row {
    border-top: 1px solid var(--color-paper-warm);
  }
  .cat-peek dt {
    flex-shrink: 0;
    color: var(--color-steel-deep);
    white-space: nowrap;
  }
  /* A value too long for the row wraps inside the card instead of running
     past its edge; min-width lets the flex item shrink below its content. */
  .cat-peek dd {
    min-width: 0;
    margin: 0;
    color: var(--color-ink);
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* The card grows to fill its grid row, so every add button in a row sits
     on the same line however long the item name runs. */
  .cat-item {
    display: flex;
    flex-direction: column;
  }
  .cat-card {
    flex: 1 0 auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-card figure,
    .cat-peek {
      transition: none;
    }
  }
</style>
