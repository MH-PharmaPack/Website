---
// A field of chips picked from a suggestion list: "Regulatory requirement"
// and "Destination market / country" on the quote form, and the market in
// the enquiry list. Behaviour is in src/scripts/chip-field.ts, started by
// the page's own script with the list to use; the chosen values travel in
// one hidden field, joined with "; ".

interface Props {
  /** Id of the text input; the list and messages derive their ids from it. */
  id: string;
  name: string;
  label: string;
  hint?: string;
  placeholder: string;
  listLabel: string;
  optional?: boolean;
  /** Which list the page script should start this field with. */
  kind: 'regulatory' | 'country';
  /** Small steel label, for the enquiry list's sheet. */
  compact?: boolean;
}

const { id, name, label, hint, placeholder, listLabel, optional, kind, compact } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
---

<div class:list={['cf', { 'cf-compact': compact }]} data-cf={kind}>
  <label class="cf-label" for={id}>
    {label}
    {optional && <span class="opt-badge">Optional</span>}
  </label>
  {hint && <p class="cf-hint" id={hintId}>{hint}</p>}
  <div class="cf-box" data-cf-box>
    <ul class="cf-chips" data-cf-chips aria-label={`Chosen: ${label}`}></ul>
    <input
      id={id}
      class="cf-input"
      type="text"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={`${id}-list`}
      aria-describedby={hintId}
      data-describedby={hintId}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="done"
      placeholder={placeholder}
      data-cf-input
    />
  </div>
  <div class="cf-pop" data-cf-pop hidden>
    <div role="listbox" id={`${id}-list`} aria-label={listLabel} aria-multiselectable="true"></div>
  </div>
  <p class="cf-msg" id={`${id}-err`} data-cf-msg hidden></p>
  <input type="hidden" name={name} data-cf-value />
  <p class="sr-only" aria-live="polite" data-cf-live></p>
</div>

<style is:global>
  /* Global on purpose: the chips and list rows are built by the script, and
     Astro's scoped styles never reach elements a script creates. Everything
     is under .cf-* so nothing leaks. */
  .cf {
    position: relative;
  }
  .cf-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-bottom: 0.45rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .cf-compact .cf-label {
    margin-bottom: 0.35rem;
    font-size: 0.8125rem;
    color: var(--color-steel-deep);
  }
  .cf-compact .cf-box {
    min-height: 2.75rem;
    padding-top: 0.2rem;
    padding-bottom: 0.2rem;
  }
  .cf-hint {
    margin: -0.15rem 0 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-steel-deep);
  }
  .cf-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: #ffffff;
    cursor: text;
    scroll-margin-top: 5.5rem;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .cf-box:focus-within {
    border-color: var(--color-steel);
    box-shadow: 0 0 0 3px rgba(78, 96, 118, 0.16);
  }
  .cf.has-err .cf-box,
  .has-err > .cf .cf-box {
    border-color: var(--color-error);
  }
  .cf-chips {
    display: contents;
    list-style: none;
  }
  .cf-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    max-width: 100%;
    min-height: 2.1rem;
    padding: 0 0.1rem 0 0.7rem;
    border-radius: 999px;
    background: var(--color-steel-deep);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .cf-chip span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cf-chip-x {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
  }
  .cf-chip-x:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
  }
  .cf-chip-x svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .cf-input {
    flex: 1 1 9rem;
    min-width: 9rem;
    height: 2.2rem;
    padding: 0 0.35rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1rem;
    outline: none;
  }
  .cf-input::placeholder {
    color: var(--color-muted);
  }
  .cf-msg {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.45rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-error);
  }
  .cf-msg::before {
    content: '!';
    display: grid;
    place-items: center;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.05rem;
    border-radius: 999px;
    background: var(--color-error);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .cf-msg[hidden] {
    display: none;
  }

  .cf-pop {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 30;
    margin-top: 0.35rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    background: #ffffff;
    box-shadow: 0 22px 48px -16px rgba(28, 38, 52, 0.4);
  }
  .cf-pop [role='listbox'] {
    padding: 0.3rem;
  }
  .cf-h {
    margin: 0;
    padding: 0.7rem 0.7rem 0.3rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-copper-deep);
  }
  .cf-opt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .cf-opt:hover,
  .cf-opt.is-active {
    background: var(--color-paper-warm);
  }
  .cf-opt.is-active {
    box-shadow: inset 2px 0 0 var(--color-copper);
  }
  .cf-opt-main {
    flex: 1;
    min-width: 0;
  }
  .cf-opt-label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .cf-opt-label mark {
    background: none;
    color: var(--color-copper-deep);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .cf-opt-sub {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-steel-deep);
  }
  .cf-opt-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border: 1.5px solid var(--color-line);
    border-radius: 0.3rem;
    color: transparent;
  }
  .cf-opt-mark svg {
    width: 1rem;
    height: 1rem;
  }
  .cf-opt[aria-selected='true'] .cf-opt-mark {
    border-color: var(--color-copper);
    background: var(--color-copper);
    color: #ffffff;
  }
  .cf-opt-add .cf-opt-label {
    color: var(--color-copper-deep);
  }
  /* Leading tile: a region code or the group's icon. Typographic by design,
     never an official logo (see src/data/regulatory.ts for why). */
  .cf-tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.3rem;
    background: var(--color-paper);
    color: var(--color-steel);
  }
  .cf-tile svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .cf-tile-code {
    border-color: var(--color-steel-deep);
    background: var(--color-steel-deep);
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .cf-opt-add .cf-tile {
    border-color: var(--color-copper);
    background: #ffffff;
    color: var(--color-copper-deep);
  }
  .cf-empty {
    margin: 0;
    padding: 0.7rem 0.7rem 0.4rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-steel-deep);
  }

  /* "Optional" badge, beside any optional field's label (client,
     2026-09-23). Global: the quote form and this component both use it. */
  .opt-badge {
    display: inline-flex;
    align-items: center;
    height: 1.35rem;
    padding: 0 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-steel-deep);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    vertical-align: middle;
  }
</style>
