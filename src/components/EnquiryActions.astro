---
import type { CatalogueItem } from '../data/catalogue';
import { WHATSAPP } from '../config';
import { enquiryMailto, enquiryWhatsApp, enquiryRfq, itemPath } from '../lib/catalogue';

// The three ways to ask about one item, in the site's usual order: email
// (opens the buyer's own mail client with the item and the RFQ fields already
// in the body, so a spec sheet can be attached), WhatsApp (prefilled), and the
// RFQ form. No backend is involved anywhere; see CLAUDE.md, contact wiring.

interface Props {
  item: CatalogueItem;
}

const { item } = Astro.props;
const absolute = Astro.site ? new URL(itemPath(item), Astro.site).href : undefined;
---

<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
  <a href={enquiryMailto(item, absolute)} class="btn btn-primary">Email an enquiry</a>
  <a
    href={enquiryWhatsApp(item)}
    class="btn btn-secondary"
    title={WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number to be added'}
  >
    WhatsApp
  </a>
  <a href={enquiryRfq(item)} class="btn btn-secondary">Request a Quote</a>
</div>
<p class="mt-3 text-xs leading-relaxed text-steel-deep">
  Email and WhatsApp open with the item already filled in. Attach a specification sheet to the
  email if you have one.
</p>
