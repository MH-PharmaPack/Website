---
import type { CatalogueItem } from '../data/catalogue';
import { WHATSAPP } from '../config';
import { enquiryMailto, enquiryWhatsApp, enquiryRfq, itemPath, enquiryAttrs } from '../lib/catalogue';

// How to ask about one item. First choice: add it to the enquiry list and
// keep browsing, so several items go to the desk as one message (the list's
// tray and sheet live in src/components/EnquiryTray.astro). Second: ask
// about this item alone, by email (opens the buyer's own mail client with
// the item and the RFQ fields filled in, so a spec sheet can be attached),
// WhatsApp, or the RFQ form. No backend anywhere; see CLAUDE.md, contact
// wiring. Without JS the add button stays hidden and the three direct links
// still work.

interface Props {
  item: CatalogueItem;
}

const { item } = Astro.props;
const absolute = Astro.site ? new URL(itemPath(item), Astro.site).href : undefined;
const enq = await enquiryAttrs(item, Astro.site);
---

<button
  type="button"
  class="enq-add enq-add-lg"
  data-enq-add
  {...enq}
  aria-pressed="false"
  aria-label={`Add ${item.name} to the enquiry list`}
  hidden
>
  <svg class="enq-add-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
    <path class="enq-add-plus" d="M12 5v14M5 12h14" stroke-linecap="round" />
    <path class="enq-add-tick" d="m5 12.5 4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="enq-add-off">Add to enquiry list</span>
  <span class="enq-add-on">In your enquiry list</span>
</button>
<p class="mt-2 text-xs leading-relaxed text-steel-deep" data-enq-hint hidden>
  Keep browsing and add more; send them all as one enquiry from the bar at the bottom of the screen.
</p>

<p class="mt-6 text-sm font-semibold text-ink">Or ask about this item on its own</p>
<div class="mt-3 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
  <a href={enquiryMailto(item, absolute)} class="btn btn-secondary">Email</a>
  <a
    href={enquiryWhatsApp(item)}
    class="btn btn-secondary"
    title={WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number to be added'}
  >
    WhatsApp
  </a>
  <a href={enquiryRfq(item)} class="btn btn-secondary">Request a Quote</a>
</div>
<p class="mt-3 text-xs leading-relaxed text-steel-deep">
  Email and WhatsApp open with the item already filled in. Attach a specification sheet to the
  email if you have one.
</p>

<style>
  /* On the item page the add button is the main action: full width on a
     phone, a normal-width primary button beside the facts on wider screens. */
  .enq-add-lg {
    min-height: 3rem;
    font-size: 1rem;
    border-color: var(--color-copper);
    background: var(--color-copper);
    color: #ffffff;
  }
  .enq-add-lg:hover {
    border-color: var(--color-copper-deep);
    background: var(--color-copper-deep);
    color: #ffffff;
  }
  .enq-add-lg[aria-pressed='true'] {
    border-color: var(--color-steel-deep);
    background: #ffffff;
    color: var(--color-steel-deep);
  }
  .enq-add-lg[aria-pressed='true']:hover {
    border-color: var(--color-ink);
    background: #ffffff;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .enq-add-lg {
      width: auto;
      padding: 0 1.75rem;
    }
  }
</style>

<script>
  // The hint under the button shows once the script (and so the list) is live.
  for (const el of document.querySelectorAll<HTMLElement>('[data-enq-hint]')) el.hidden = false;
</script>
