---
// The enquiry list's tray and its review-and-send sheet. Included on the
// catalogue page and every item page. The list itself lives in the visitor's
// browser (src/scripts/enquiry-list.ts); nothing is sent anywhere until they
// press Email, WhatsApp or the quote form.
//
// Tray: a bar fixed to the bottom of the screen, shown only while the list
// has items. On a phone it takes the place of the floating quick-actions
// pill (the sheet carries WhatsApp and the quote form, so nothing is lost);
// on wider screens it floats above the page.
//
// Sheet: a native <dialog>, so focus is held inside it and Escape closes it
// without any script of ours. Bottom sheet on a phone, centred panel above.
import { TIMELINES } from '../data/rfq';
import ChipField from './ChipField.astro';
---

<div class="sr-only" aria-live="polite" data-enq-live></div>

<div class="enq-bar" data-enq-bar hidden>
  <button type="button" class="enq-bar-btn" data-enq-open aria-haspopup="dialog">
    <span class="enq-n" data-enq-count>0</span>
    <span class="enq-bar-text">
      <b>Your enquiry list</b>
      <span data-enq-names></span>
    </span>
    <span class="enq-bar-cta">Review &amp; send</span>
  </button>
</div>

<dialog class="enq-dialog" data-enq-dialog aria-labelledby="enq-title">
  <div class="enq-sheet">
    <div class="enq-head">
      <h2 id="enq-title" class="text-xl font-bold tracking-tight text-ink">
        Your enquiry list <span class="enq-head-n" data-enq-count-text></span>
      </h2>
      <button type="button" class="enq-x" data-enq-close aria-label="Close">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <p class="mt-1 text-sm leading-relaxed text-steel-deep">
      Add a quantity to each item if you know it. Everything here goes to our sales desk as one
      message.
    </p>

    <ul class="enq-list" data-enq-list></ul>

    <div class="enq-fields">
      <ChipField
        kind="country"
        id="enq-market"
        name="market"
        label="Destination market"
        placeholder="Start typing a country"
        listLabel="Countries and markets"
        compact
      />
      <label class="enq-field">
        <span>Required timeline</span>
        <select data-enq-field="timeline">
          <option value="">Choose</option>
          {TIMELINES.map((t) => <option value={t}>{t}</option>)}
        </select>
      </label>
    </div>

    <div class="enq-send">
      <a class="btn btn-primary" href="#" data-enq-mail>Email the list</a>
      <a class="btn btn-secondary" href="#" data-enq-wa>WhatsApp</a>
      <a class="btn btn-secondary" href="#" data-enq-rfq>Request a Quote</a>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-steel-deep">
      Email and WhatsApp open with the whole list filled in. Attach a specification sheet to the
      email if you have one.
    </p>

    <div class="enq-foot">
      <button type="button" class="enq-link" data-enq-copy>Copy the list</button>
      <button type="button" class="enq-link" data-enq-clear>Clear the list</button>
    </div>
  </div>
</dialog>

<style>
  /* ---- The tray ------------------------------------------------------ */
  .enq-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 55;
    padding: 0.5rem 0.75rem calc(env(safe-area-inset-bottom) + 0.5rem);
    background: var(--color-band);
    box-shadow: 0 -12px 30px rgba(0, 0, 0, 0.28);
    animation: enq-rise 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .enq-bar-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3rem;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    color: var(--color-paper);
    text-align: left;
    cursor: pointer;
  }
  .enq-n {
    flex: none;
    display: grid;
    place-items: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--color-copper);
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .enq-bar-text {
    min-width: 0;
    flex: 1;
    font-size: 0.8125rem;
    line-height: 1.35;
  }
  .enq-bar-text b {
    display: block;
    font-size: 0.875rem;
  }
  .enq-bar-text span {
    display: block;
    color: var(--color-mist);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .enq-bar-cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 0.25rem;
    background: var(--color-copper);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .enq-bar-btn:hover .enq-bar-cta {
    background: var(--color-copper-deep);
  }
  @media (min-width: 768px) {
    .enq-bar {
      left: 50%;
      right: auto;
      bottom: 1.25rem;
      width: min(46rem, calc(100% - 4rem));
      transform: translateX(-50%);
      padding: 0.6rem 0.75rem;
      border-radius: 0.75rem;
      animation-name: enq-rise-centred;
    }
  }
  @keyframes enq-rise {
    from { transform: translateY(100%); }
    to { transform: none; }
  }
  @keyframes enq-rise-centred {
    from { transform: translate(-50%, 140%); }
    to { transform: translateX(-50%); }
  }

  /* Room at the foot of the page so the tray never covers the last row, and
     on a phone the quick-actions pill steps aside for it. While the mobile
     menu is open the tray steps aside instead. */
  :global(html.has-enquiry body) {
    padding-bottom: 6rem;
  }
  :global(html.has-enquiry [data-quick-actions]) {
    display: none;
  }
  :global(html.nav-locked) .enq-bar {
    display: none;
  }

  /* ---- The sheet ----------------------------------------------------- */
  .enq-dialog {
    width: min(40rem, calc(100% - 2rem));
    max-height: min(88vh, 52rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 0.75rem;
    background: #ffffff;
    color: var(--color-ink);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    overscroll-behavior: contain;
  }
  .enq-dialog::backdrop {
    background: rgba(28, 38, 52, 0.55);
  }
  .enq-sheet {
    padding: 1.25rem 1.25rem 1.5rem;
  }
  @media (max-width: 767px) {
    .enq-dialog {
      width: 100%;
      max-width: none;
      max-height: 90vh;
      margin: auto 0 0;
      border-radius: 1rem 1rem 0 0;
    }
    .enq-dialog[open] {
      animation: enq-rise 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .enq-sheet {
      padding-bottom: calc(env(safe-area-inset-bottom) + 1.25rem);
    }
  }
  @media (min-width: 768px) {
    .enq-sheet {
      padding: 1.75rem 2rem 2rem;
    }
  }
  .enq-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .enq-head-n {
    color: var(--color-steel-deep);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .enq-x {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.6rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-steel-deep);
    cursor: pointer;
  }
  .enq-x:hover {
    background: var(--color-paper-warm);
  }

  .enq-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .enq-list :global(li) {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 2.75rem;
    grid-template-areas:
      'th name rm'
      'th qty qty';
    column-gap: 0.75rem;
    row-gap: 0.4rem;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .enq-list :global(.enq-th) {
    grid-area: th;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: #ffffff;
    object-fit: contain;
  }
  .enq-list :global(.enq-name) {
    grid-area: name;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .enq-list :global(.enq-name a) {
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .enq-list :global(.enq-name a:hover) {
    color: var(--color-copper-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .enq-list :global(.enq-cat) {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.75rem;
    color: var(--color-steel-deep);
  }
  .enq-list :global(.enq-q) {
    grid-area: qty;
    display: flex;
    gap: 0.5rem;
    max-width: 19rem;
  }
  .enq-list :global(.enq-qty),
  .enq-list :global(.enq-unit) {
    height: 2.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 1rem;
  }
  .enq-list :global(.enq-qty) {
    flex: 1;
    min-width: 0;
    padding: 0 0.75rem;
  }
  .enq-list :global(.enq-unit) {
    flex: none;
    width: 6.75rem;
    padding: 0 0.5rem;
  }
  .enq-list :global(.enq-qty:focus),
  .enq-list :global(.enq-unit:focus) {
    border-color: var(--color-steel);
    outline: none;
    background: #ffffff;
  }
  .enq-list :global(.enq-rm) {
    grid-area: rm;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-steel-deep);
    cursor: pointer;
  }
  .enq-list :global(.enq-rm:hover) {
    background: var(--color-paper-warm);
    color: var(--color-ink);
  }
  .enq-list :global(.enq-rm svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .enq-fields {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 640px) {
    .enq-fields {
      grid-template-columns: 1fr 1fr;
    }
  }
  .enq-field span {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-steel-deep);
  }
  .enq-field input,
  .enq-field select {
    width: 100%;
    height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: #ffffff;
    color: var(--color-ink);
    font-size: 1rem;
  }
  .enq-field input:focus,
  .enq-field select:focus {
    border-color: var(--color-steel);
    outline: none;
  }

  .enq-send {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .enq-send {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
  .enq-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .enq-link {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-copper-deep);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .enq-link:hover {
    color: var(--color-copper);
  }

  @media (prefers-reduced-motion: reduce) {
    .enq-bar,
    .enq-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  import {
    load,
    toggle,
    remove,
    setQty,
    setField,
    clear,
    onChange,
    has,
    mailtoHref,
    whatsappHref,
    rfqHref,
    plainText,
    type EnquiryItem,
  } from '../scripts/enquiry-list';
  import { numericOnly, formatQuantity } from '../scripts/numeric';
  import { initChipField } from '../scripts/chip-field';
  import { COUNTRY_GROUPS } from '../data/countries';
  import { UNITS } from '../data/rfq';

  const bar = document.querySelector<HTMLElement>('[data-enq-bar]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-enq-dialog]');
  const list = document.querySelector<HTMLUListElement>('[data-enq-list]');
  const live = document.querySelector<HTMLElement>('[data-enq-live]');
  const mail = document.querySelector<HTMLAnchorElement>('[data-enq-mail]');
  const wa = document.querySelector<HTMLAnchorElement>('[data-enq-wa]');
  const rfq = document.querySelector<HTMLAnchorElement>('[data-enq-rfq]');
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-enq-copy]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-enq-clear]');
  const fields = [...document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-enq-field]')];

  // Destination market: chosen from the country list only, like the quote
  // form. Stored in the list as one string, markets joined with "; ".
  const marketRoot = dialog?.querySelector<HTMLElement>('[data-cf="country"]') ?? null;
  const marketField = marketRoot
    ? initChipField(marketRoot, {
        groups: COUNTRY_GROUPS,
        strict: true,
        strictMessage: 'Choose a country from the list.',
      })
    : null;
  marketRoot?.querySelector('[data-cf-value]')?.addEventListener('input', () => {
    if (marketField) setField('market', marketField.get().join('; '));
  });

  const addButtons = () => [...document.querySelectorAll<HTMLButtonElement>('[data-enq-add]')];
  const itemFrom = (b: HTMLElement): Omit<EnquiryItem, 'qty' | 'unit'> => ({
    slug: b.dataset.enqSlug ?? '',
    name: b.dataset.enqName ?? '',
    category: b.dataset.enqCategory ?? '',
    line: b.dataset.enqLine ?? '',
    detail: b.dataset.enqDetail ?? '',
    url: b.dataset.enqUrl ?? '',
    thumb: b.dataset.enqThumb ?? '',
  });

  const icon = (d: string) =>
    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="${d}" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

  // Rebuild the sheet's rows. Quantity inputs are only rebuilt when the set
  // of items changes, so typing into one never loses focus mid-word.
  let renderedSlugs = '';
  const renderList = () => {
    if (!list) return;
    const s = load();
    const slugs = s.items.map((i) => i.slug).join('|');
    if (slugs === renderedSlugs) return;
    renderedSlugs = slugs;
    list.replaceChildren(
      ...s.items.map((it) => {
        const li = document.createElement('li');
        if (it.thumb) {
          const img = document.createElement('img');
          img.className = 'enq-th';
          img.src = it.thumb;
          img.alt = '';
          img.loading = 'lazy';
          img.addEventListener('error', () => (img.style.visibility = 'hidden'));
          li.appendChild(img);
        } else {
          li.appendChild(Object.assign(document.createElement('span'), { className: 'enq-th' }));
        }
        const name = document.createElement('div');
        name.className = 'enq-name';
        const a = document.createElement('a');
        a.href = it.url || '#';
        a.textContent = it.name;
        const cat = document.createElement('span');
        cat.className = 'enq-cat';
        cat.textContent = [it.category, it.detail].filter(Boolean).join(' · ');
        name.append(a, cat);
        // Quantity: numbers only, with the unit beside it.
        const q = document.createElement('div');
        q.className = 'enq-q';
        const qty = document.createElement('input');
        qty.type = 'text';
        qty.className = 'enq-qty';
        qty.placeholder = 'Quantity';
        qty.value = formatQuantity(it.qty);
        qty.setAttribute('aria-label', `Quantity for ${it.name}`);
        numericOnly(qty, 'quantity');
        const unit = document.createElement('select');
        unit.className = 'enq-unit';
        unit.setAttribute('aria-label', `Unit for ${it.name}`);
        for (const u of UNITS) unit.add(new Option(u, u));
        unit.value = it.unit || 'pieces';
        const store = () => setQty(it.slug, qty.value.trim(), unit.value);
        qty.addEventListener('input', store);
        unit.addEventListener('change', store);
        q.append(qty, unit);
        const rm = document.createElement('button');
        rm.type = 'button';
        rm.className = 'enq-rm';
        rm.setAttribute('aria-label', `Remove ${it.name}`);
        rm.innerHTML = icon('M6 6l12 12M18 6 6 18');
        rm.addEventListener('click', () => {
          remove(it.slug);
          if (live) live.textContent = `Removed ${it.name}.`;
        });
        li.append(name, q, rm);
        return li;
      }),
    );
  };

  let clearArmed = false;
  const render = () => {
    const s = load();
    const n = s.items.length;
    document.documentElement.classList.toggle('has-enquiry', n > 0);
    if (bar) bar.hidden = n === 0;
    for (const el of document.querySelectorAll('[data-enq-count]')) el.textContent = String(n);
    for (const el of document.querySelectorAll('[data-enq-count-text]')) {
      el.textContent = `· ${n} item${n === 1 ? '' : 's'}`;
    }
    const names = document.querySelector('[data-enq-names]');
    if (names) names.textContent = s.items.map((i) => i.name).join(' · ');
    for (const b of addButtons()) {
      b.hidden = false;
      b.setAttribute('aria-pressed', String(has(s, b.dataset.enqSlug ?? '')));
    }
    renderList();
    for (const f of fields) {
      const key = f.dataset.enqField as 'market' | 'timeline';
      if (document.activeElement !== f) f.value = s[key];
    }
    // Only when the stored markets differ, so typing in the field (or a
    // change from another tab) never wipes a half-typed name.
    if (marketField) {
      const stored = s.market.split(/\s*;\s*/).filter(Boolean);
      if (stored.join('; ') !== marketField.get().join('; ')) marketField.set(stored);
    }
    if (mail) mail.href = mailtoHref(s);
    if (wa) wa.href = whatsappHref(s);
    if (rfq) rfq.href = rfqHref(s);
    if (n === 0 && dialog?.open) dialog.close();
    if (clearBtn && clearArmed) {
      clearArmed = false;
      clearBtn.textContent = 'Clear the list';
    }
  };

  // Add / remove from any card or item page button.
  document.addEventListener('click', (e) => {
    const b = (e.target as Element | null)?.closest<HTMLButtonElement>('[data-enq-add]');
    if (!b) return;
    const item = itemFrom(b);
    const added = toggle(item);
    const n = load().items.length;
    if (live) {
      live.textContent = added
        ? `Added ${item.name} to the enquiry list. ${n} item${n === 1 ? '' : 's'} in the list.`
        : `Removed ${item.name} from the enquiry list.`;
    }
  });

  document.querySelector('[data-enq-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-enq-close]')?.addEventListener('click', () => dialog?.close());
  // A click on the backdrop lands on the <dialog> element itself.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  for (const f of fields) {
    f.addEventListener('input', () => setField(f.dataset.enqField as 'market' | 'timeline', f.value.trim()));
  }

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(plainText(load()));
      copyBtn.textContent = 'Copied';
    } catch {
      copyBtn.textContent = 'Copy failed: use Email instead';
    }
    setTimeout(() => (copyBtn.textContent = 'Copy the list'), 2200);
  });

  // Two taps to clear, so one stray tap cannot throw away a long list.
  clearBtn?.addEventListener('click', () => {
    if (!clearArmed) {
      clearArmed = true;
      clearBtn.textContent = 'Tap again to clear';
      setTimeout(() => {
        if (clearArmed) {
          clearArmed = false;
          clearBtn.textContent = 'Clear the list';
        }
      }, 3000);
      return;
    }
    clear();
    if (live) live.textContent = 'Enquiry list cleared.';
  });

  onChange(render);
  render();
</script>
