---
import logo from '../assets/logo/mh-pharmapack-logo.svg';
import {
  NAV,
  SALES_EMAIL,
  MAILTO_HREF,
  PHONE,
  PHONE_DISPLAY,
  TEL_HREF,
  WHATSAPP,
  WHATSAPP_HREF,
  OFFICE_ADDRESS,
  MAPS_HREF,
  MAP_EMBED_SRC,
  withBase,
} from '../config';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper-warm">
  <div class="mx-auto max-w-content px-5 pt-14 pb-10 md:px-8">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1.2fr] md:gap-8">
      <div>
        <a href={withBase('/')} class="flex items-center gap-3" aria-label="MH PharmaPack, home">
          <img src={logo.src} width={logo.width} height={logo.height} alt="" class="h-10 w-auto" />
          <span class="flex flex-col gap-0.5 leading-none">
            <span class="text-[0.85rem] font-bold tracking-lockup text-ink">MH PHARMAPACK</span>
            <span class="text-[0.58rem] font-semibold tracking-eyebrow text-steel-deep uppercase">
              Pharmaceutical Sourcing &amp; Supply
            </span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-steel-deep">
          A sourcing and supply intermediary connecting pharmaceutical buyers with approved
          manufacturers, and coordinating each engagement end to end.
        </p>
      </div>

      <nav aria-label="Footer">
        <h2 class="eyebrow">Navigate</h2>
        <ul class="mt-4 space-y-2.5">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="text-sm font-medium text-steel-deep transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={withBase('/privacy')} class="text-sm font-medium text-steel-deep transition-colors hover:text-ink">
              Privacy Policy
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow">Contact</h2>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed">
          <li>
            <a href={MAILTO_HREF} class="font-medium text-steel-deep transition-colors hover:text-ink">
              {SALES_EMAIL}
            </a>
          </li>
          <li>
            {PHONE ? (
              /* tel: takes the unpunctuated E.164 number; the spaced form is
                 display only, since dialers choke on the spaces. */
              <a href={TEL_HREF} class="font-medium text-steel-deep transition-colors hover:text-ink">
                {PHONE_DISPLAY}
              </a>
            ) : (
              <span class="placeholder-note">[Phone number to be added]</span>
            )}
          </li>
          <li>
            {WHATSAPP ? (
              /* WHATSAPP_HREF carries the prefilled enquiry message */
              <a
                href={WHATSAPP_HREF}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-steel-deep transition-colors hover:text-ink"
              >
                WhatsApp
              </a>
            ) : (
              <span class="placeholder-note">[WhatsApp number to be added]</span>
            )}
          </li>
          <li class="pt-1">
            {
              OFFICE_ADDRESS ? (
                <a
                  href={MAPS_HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="not-italic text-steel-deep transition-colors hover:text-ink"
                >
                  {OFFICE_ADDRESS}
                </a>
              ) : (
                <span class="placeholder-note">[Office address to be added]</span>
              )
            }
          </li>
        </ul>
      </div>
    </div>

    <!-- Office map. The pin, the "Get directions" link, and the printed address
         in the Contact column are all derived from OFFICE_ADDRESS in config.ts,
         so they cannot drift apart when the address changes.

         This is Google's keyless ?output=embed endpoint, so there is no Cloud
         API key to leak or rotate. It is third-party content: it loads only
         when scrolled to (loading="lazy") but it will set Google cookies at
         that point, which is worth a line in the privacy policy. -->
    {
      OFFICE_ADDRESS && (
        <div class="mt-12">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 class="eyebrow">Office</h2>
            <a
              href={MAPS_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-semibold text-copper-deep underline underline-offset-4 transition-colors hover:text-copper"
            >
              Get directions
            </a>
          </div>
          <div class="footer-map mt-4 overflow-hidden rounded-md border border-line">
            <iframe
              src={MAP_EMBED_SRC}
              title={`Map showing the MH PharmaPack office at ${OFFICE_ADDRESS}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        </div>
      )
    }

    <!-- Intermediary disclaimer, verbatim from CONTENT-SPEC.md section 8.2. Do not soften. -->
    <div class="mt-12 border-t border-line pt-8">
      <p class="max-w-4xl text-xs leading-relaxed text-steel-deep">
        MH PharmaPack acts as a sourcing and supply intermediary. We facilitate introductions
        between buyers and manufacturers and coordinate transactions. We do not manufacture
        pharmaceutical products and do not take title to goods. Contracts of sale are entered
        into directly between the buyer and the manufacturer. MH PharmaPack is not a party to
        those contracts and does not guarantee, warrant, or assume liability for product
        quality, regulatory compliance, delivery, or payment. All certifications and approvals
        referenced belong to the respective manufacturing partners.
      </p>
      <p class="mt-6 text-xs text-steel-deep">&copy; {year} MH PharmaPack.</p>
    </div>
  </div>
</footer>

<style>
  /* Google's own map is a saturated consumer blue that fights the Cleanroom
     palette, so it sits slightly desaturated at rest and returns to full
     colour on hover or keyboard focus, when the reader is actually using it.
     Never filter it so hard that road labels stop being legible. */
  .footer-map iframe {
    display: block;
    width: 100%;
    height: 260px;
    border: 0;
    filter: saturate(0.72) contrast(1.02);
    transition: filter 300ms ease;
  }
  .footer-map:hover iframe,
  .footer-map:focus-within iframe {
    filter: none;
  }
  @media (max-width: 640px) {
    .footer-map iframe { height: 210px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-map iframe { transition: none; }
  }
</style>
