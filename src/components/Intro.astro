<style is:global>
  /* Hidden unless this page view won the once-per-session gate */
  .sheet,
  .lock,
  .replay {
    display: none;
  }
  html.intro-pending .sheet {
    display: block;
    position: fixed;
    inset: 0;
    background: var(--color-paper);
    z-index: 70;
  }
  html.intro-pending .lock {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 71;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    pointer-events: none;
  }
  /* The site shell is NOT hidden: the sheet above it is opaque paper, so the
     page sits fully rendered beneath it from first paint and its entire
     rasterization happens during load instead of at the dock. The earlier
     `#site-shell { opacity: 0 }` plus a dock-time fade-in animated group
     opacity across the whole page (header, live canvas, every section)
     exactly while the mark was flying to the header, which is what dropped
     the dock's frames. The sheet's own fade is the one and only reveal.
     Only the header lockup stays hidden, so the docked mark replaces it. */
  html.intro-pending #header-logo-img {
    display: none;
  }
  html.intro-pending #header-lockup-text {
    opacity: 0;
  }

  /* Intro internals, from the provided file. The script tints letters via these vars. */
  .lock {
    --steel: #4e6076;
    --copper: #a9663f;
    --ink: #26303d;
  }
  .markbox {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #mark {
    width: min(31vh, 300px);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 16px 26px rgba(38, 48, 61, 0.13));
  }
  #mark #ringSteel,
  #mark #ringCopper,
  #mark #capTop,
  #mark #capBot,
  #mark .pc,
  #mark .spark {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }
  #drawS,
  #drawC {
    stroke-dasharray: 0 99999;
  }
  #capTop,
  #capBot,
  #mark .pc,
  #mark .spark {
    opacity: 0;
  }
  .type {
    font-weight: 700;
    letter-spacing: 0.24em;
    white-space: pre;
    padding-left: 0.24em;
    font-size: clamp(15px, 2.3vw, 25px);
    display: flex;
    color: var(--color-ink);
  }
  #morph {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  #morph span {
    display: inline-block;
    opacity: 0;
    will-change: transform, opacity, filter;
  }
  #word {
    opacity: 0;
  }
  .tag {
    font-size: 10px;
    letter-spacing: 0.36em;
    color: var(--color-muted);
    font-weight: 600;
    opacity: 0;
    margin-top: -14px;
  }
</style>

<script>
function mhIntro() {

const CFG = {
  word: "MH PHARMAPACK",
  steelLetters: [0, 1],   // tinted steel in the wordmark
  fromSteel: 0,           // the arrow tears out of this letter
  fromCopper: 12,         // the molecule tears out of this letter
  speed: 0.5,             // every duration and delay scales by this. 1 is the old snappy timing
  lockup: true,           // let the wordmark reform under the mark afterwards
  autoDock: true
};

/* every beat, in ms at speed 1 */
const t = {
  inDur:100,  inStagger:5,
  pulseS:100, pulseC:112,
  flyS:105,   flyC:118,   flyDur:70,
  meltS:130,  meltStagger:6, meltDur:170,
  drawS:175,  drawC:188,  drawDur:175,
  capT:240,   capB:262,   capDur:190,
  icons:265,  iconStagger:11, iconDur:145,
  word:400,   tag:480,    dock:620
};

const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const svg=$('#mark'), sheet=$('#sheet'), lock=$('#lockup'), site=$('#site-shell'), slot=$('#header-logo-slot'),
      brandtxt=$('#header-lockup-text'), replay=$('#replay'), morph=$('#morph'), wordEl=$('#word'), tagEl=$('#tag');

function tint(i){
  if (i===CFG.fromCopper) return 'var(--copper)';
  if (CFG.steelLetters.includes(i)) return 'var(--steel)';
  return 'var(--ink)';
}
const chars=[...CFG.word].map((ch,i)=>{
  const s=document.createElement('span'); s.textContent=ch; s.style.color=tint(i);
  morph.appendChild(s); return s;
});
[...CFG.word].forEach((ch,i)=>{
  const s=document.createElement('span'); s.textContent=ch; s.style.color=tint(i);
  wordEl.appendChild(s);
});

const T=ms=>ms/CFG.speed;
let anims=[];
const play=(el,kf,opt)=>{const a=el.animate(kf,{fill:'both',...opt}); anims.push(a); return a;};

const CTM = ()=>svg.getScreenCTM();
function toUser(cx,cy){ const p=svg.createSVGPoint(); p.x=cx; p.y=cy; return p.matrixTransform(CTM().inverse()); }
function toScreen(x,y){ const p=svg.createSVGPoint(); p.x=x; p.y=y; return p.matrixTransform(CTM()); }
function boxCentre(el){ const r=el.getBoundingClientRect(); return {x:r.left+r.width/2, y:r.top+r.height/2}; }
function guideCentre(g){ const b=g.getBBox(); return toScreen(b.x+b.width/2, b.y+b.height/2); }

/* a spark leaves its letter, then rides its loop while the loop paints itself behind it */
function spark(el, guide, letter, t0, spin){
  const L=guide.getTotalLength(), src=toUser(boxCentre(letter).x, boxCentre(letter).y);
  const p0=guide.getPointAtLength(0);
  const fly=T(t.flyDur), draw=T(t.drawDur), total=fly+draw, oF=fly/total, kf=[];
  const ctrl={x:(src.x+p0.x)/2-(p0.y-src.y)*0.35, y:(src.y+p0.y)/2+(p0.x-src.x)*0.35};
  const ang0=Math.atan2(p0.y-ctrl.y,p0.x-ctrl.x)*180/Math.PI+90;
  for(let i=0;i<=7;i++){
    const u=i/7, iu=1-u;
    const x=iu*iu*src.x+2*iu*u*ctrl.x+u*u*p0.x, y=iu*iu*src.y+2*iu*u*ctrl.y+u*u*p0.y;
    kf.push({offset:oF*u, opacity:Math.min(1,u*3.5),
      transform:'translate('+x.toFixed(1)+'px,'+y.toFixed(1)+'px) rotate('+(spin?ang0.toFixed(0):0)+'deg) scale('+(0.25+0.75*u).toFixed(2)+')',
      easing:'cubic-bezier(.3,.05,.3,1)'});
  }
  for(let i=0;i<=34;i++){
    const f=i/34, p=guide.getPointAtLength(f*L);
    let rot=0;
    if(spin){ const q=guide.getPointAtLength(Math.min(L,f*L+8));
      rot=Math.atan2(q.y-p.y,q.x-p.x)*180/Math.PI+90; }
    const fade = f>0.84 ? 1-(f-0.84)/0.16 : 1;
    kf.push({offset:oF+(1-oF)*f, opacity:fade,
      transform:'translate('+p.x.toFixed(1)+'px,'+p.y.toFixed(1)+'px) rotate('+rot.toFixed(1)+'deg) scale('+(0.55+0.45*fade).toFixed(2)+')',
      easing:'linear'});
  }
  return play(el, kf, {duration:total, delay:T(t0)});
}

function run(){
  anims=[];

  /* 1. the name lands */
  chars.forEach((c,i)=>play(c,
    [{opacity:0, transform:'translateY(9px)', filter:'blur(3px)'},
     {opacity:1, transform:'none', filter:'blur(0px)'}],
    {duration:T(t.inDur), delay:T(i*t.inStagger), easing:'cubic-bezier(.2,.8,.3,1)'}));

  /* 2. two letters give something up */
  [[CFG.fromSteel,t.pulseS],[CFG.fromCopper,t.pulseC]].forEach(p=>
    play(chars[p[0]], [{transform:'scale(1)'},{transform:'scale(1.3)'},{transform:'scale(1)'}],
      {duration:T(150), delay:T(p[1]-25), easing:'ease-out'}));

  spark($('#sparkS'), $('#gS'), chars[CFG.fromSteel],  t.flyS, true);
  spark($('#sparkC'), $('#gC'), chars[CFG.fromCopper], t.flyC, false);

  /* 3. the wordmark dissolves into the two loops it is becoming */
  const mid = boxCentre(svg).x;
  const tgt = {S: guideCentre($('#gS')), C: guideCentre($('#gC'))};
  chars.forEach((c,i)=>{
    const p = boxCentre(c);
    const steel = p.x < mid;
    const to = steel ? tgt.S : tgt.C;
    const dx=(to.x-p.x)*0.82, dy=(to.y-p.y)*0.82;
    const emit = (i===CFG.fromSteel || i===CFG.fromCopper);
    play(c, [
      {opacity:1, transform:'translate(0,0) scale(1)', filter:'blur(0px)'},
      {opacity:0, filter:'blur(5px)', color: steel ? '#4e6076' : '#a9663f',
       transform:'translate('+dx.toFixed(1)+'px,'+dy.toFixed(1)+'px) scale(.34)'}
    ], {duration:T(emit ? 110 : t.meltDur),
        delay:T(emit ? (i===CFG.fromSteel ? t.flyS : t.flyC)
                     : t.meltS + Math.abs(i-6)*t.meltStagger),
        easing:'cubic-bezier(.45,.02,.5,1)'});
  });

  /* 4. the loops paint themselves in the sparks' wake */
  [['#drawS',t.drawS],['#drawC',t.drawC]].forEach(p=>{
    const el=$(p[0]), L=el.getTotalLength();
    el.style.strokeDasharray = L+'px '+L+'px';
    play(el, [{strokeDashoffset:L+'px'},{strokeDashoffset:'0px'}],
      {duration:T(t.drawDur), delay:T(p[1]), easing:'linear'});
  });

  /* the arrowhead and the molecule cannot be reached by a stroke, so they bloom
     out of their own centres exactly as the sweep passes them */
  $$('#mSteel .pt, #mCopper .pt').forEach(c=>{
    const base = c.closest('mask').id==='mSteel' ? t.drawS : t.drawC;
    play(c, [{r:'0px'},{r:c.dataset.r+'px'}],
      {duration:T(150), delay:T(base + (+c.dataset.f)*t.drawDur*0.92),
       easing:'cubic-bezier(.2,.85,.3,1)'});
  });
  $$('.safe').forEach(r=>play(r, [{opacity:0},{opacity:1}],
    {duration:T(130), delay:T(t.drawS+t.drawDur+55), easing:'ease-out'}));

  /* 5. the angled edges hover, then lock */
  [['#capTop',-110,t.capT],['#capBot',110,t.capB]].forEach(c=>{
    const hov=(c[1]*0.09).toFixed(1);
    play($(c[0]), [
      {offset:0,   opacity:0, transform:'translateY('+c[1]+'px) scale(.92)'},
      {offset:.56, opacity:1, transform:'translateY('+hov+'px) scale(1.018)', easing:'cubic-bezier(.15,.9,.3,1)'},
      {offset:.76, opacity:1, transform:'translateY('+hov+'px) scale(1.018)'},
      {offset:1,   opacity:1, transform:'translateY(0) scale(1)'}
    ], {duration:T(t.capDur), delay:T(c[2]), easing:'cubic-bezier(.45,0,.2,1)'});
  });

  /* 6. the contents settle inside the loops */
  $$('#iconsSteel .pc, #iconsCopper .pc')
    .sort((a,b)=>a.getBBox().y-b.getBBox().y)
    .forEach((g,i)=>play(g, [
      {opacity:0, transform:'scale(.45)'},
      {opacity:1, transform:'scale(1.09)', offset:.6},
      {opacity:1, transform:'scale(1)'}
    ], {duration:T(t.iconDur), delay:T(t.icons+i*t.iconStagger), easing:'cubic-bezier(.2,.9,.3,1)'}));

  /* 7. the name reforms beneath the finished mark */
  if (CFG.lockup)
    play(wordEl, [{opacity:0, transform:'translateY(10px) scale(.96)'},{opacity:1, transform:'none'}],
      {duration:T(200), delay:T(t.word), easing:'cubic-bezier(.2,.85,.3,1)'});
  play(tagEl, [{opacity:0, transform:'translateY(6px)'},{opacity:1, transform:'none'}],
    {duration:T(170), delay:T(t.tag), easing:'ease-out'});

  if (CFG.autoDock) setTimeout(dock, T(t.dock));
}

/* ---- hand the mark over to the header ---- */
let docked=false;
function dock(){
  /* lock.isConnected: if the stall-safety already tore the overlay down,
     a late dock must not fly a detached svg into the header next to the
     restored static logo. */
  if(docked || !lock.isConnected) return; docked=true;
  /* Handshake for the rest of the page, at the START of the dock so the
     hero's pre-warmed render loop resumes while the mark is still flying:
     by the time the sheet lifts, the river is already in motion.
     Integration wiring, not animation logic. */
  window.__mhIntroDone = true;
  dispatchEvent(new Event('mh:intro-done'));
  const a=svg.getBoundingClientRect(), b=slot.getBoundingClientRect();
  const s=b.width/a.width;
  const dx=(b.left+b.width/2)-(a.left+a.width/2);
  const dy=(b.top+b.height/2)-(a.top+a.height/2);

  /* No site fade-in here: the page is already rendered under the opaque
     sheet (see the CSS note above), so the sheet fading is the reveal. */
  sheet.animate([{opacity:1},{opacity:0}], {duration:T(330), delay:T(100), fill:'both', easing:'ease-in'});
  [wordEl,tagEl].forEach(el=>el.animate(
    [{opacity:1},{opacity:0, transform:'translateY(-8px)'}],
    {duration:T(220), fill:'both', easing:'ease-in'}));

  const fly=svg.animate([{transform:'none'},{transform:'translate('+dx+'px,'+dy+'px) scale('+s+')'}],
    {duration:T(480), fill:'both', easing:'cubic-bezier(.6,.02,.2,1)'});

  fly.onfinish=()=>{
    svg.getAnimations().forEach(x=>x.cancel());
    svg.style.cssText='width:100%;height:100%;overflow:visible';
    slot.appendChild(svg);
    sheet.style.display='none'; lock.style.display='none';
    brandtxt.animate([{opacity:0, transform:'translateX(-6px)'},{opacity:1, transform:'none'}],
      {duration:T(240), fill:'both', easing:'ease-out'});
    replay.animate([{opacity:0},{opacity:1}], {duration:T(280), fill:'both'});
  };
}

addEventListener('click', e=>{
  if(docked || e.target===replay) return;
  anims.forEach(a=>a.finish());
  dock();
});

replay.onclick=()=>{
  docked=false;
  if(slot.contains(svg)){ svg.removeAttribute('style'); $('#markbox').insertBefore(svg, morph); }
  sheet.style.display=''; lock.style.display='';
  [site,sheet,wordEl,tagEl,brandtxt,replay,svg].forEach(el=>el.getAnimations().forEach(a=>a.cancel()));
  svg.querySelectorAll('*').forEach(el=>el.getAnimations().forEach(a=>a.cancel()));
  chars.forEach(c=>c.getAnimations().forEach(a=>a.cancel()));
  requestAnimationFrame(run);
};

if (matchMedia('(prefers-reduced-motion: reduce)').matches){
  morph.style.display='none';
  wordEl.style.opacity=1; tagEl.style.opacity=1;
  $$('#mark .pc').forEach(g=>g.style.opacity=1);
  ['#capTop','#capBot'].forEach(s=>$(s).style.opacity=1);
  $$('.safe').forEach(r=>r.style.opacity=1);
  dock();
} else {
  /* Start as soon as the intro's own dependencies are ready, NOT on
     window.load. The intro is fully self-contained (inline SVG, inline
     texture); waiting for load meant waiting for the ~500 KB hero chunk,
     the fonts, and every image before the first frame, which is what made
     the site feel dead on arrival. The only external dependency is the
     wordmark's font, so wait for that alone, capped at 900 ms so a slow
     font can never hold the page hostage (fallback type is better than a
     blank sheet). */
  const startRun = () => requestAnimationFrame(run);
  const fontReady = document.fonts && document.fonts.load
    ? document.fonts.load('700 25px "Inter Variable"').catch(() => {})
    : Promise.resolve();
  const fontRace = Promise.race([fontReady, new Promise((r) => setTimeout(r, 900))]);
  /* The mark's texture is an external asset now (preloaded above). The
     intro must not start before it is decodable, or the rings would draw
     untextured, so this wait is deliberately UNCAPPED: if the image never
     arrives, run() never starts and the 7s visible stall-safety reveals
     the site cleanly, which beats playing a broken intro. */
  const texReady = new Promise((res) => {
    const el = document.querySelector('#art image');
    const url = el && el.getAttribute('href');
    if (!url) return res();
    const probe = new Image();
    probe.onload = () => res();
    probe.src = url;
  });
  Promise.all([fontRace, texReady]).then(startRun);
}

}
if (document.documentElement.classList.contains('intro-pending')) {
  mhIntro();
} else {
  for (const id of ['sheet', 'lockup', 'replay']) document.getElementById(id)?.remove();
}
</script>
