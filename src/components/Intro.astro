---
// Intro overlay: the provided assets/mh-pharmapack-intro.html, integrated per CLAUDE.md.
// The animation logic below is verbatim from that file. Only the dock/site selectors are
// rewired to the real header lockup.
// Plays on every load of the home route (client decision 2026-07-15, supersedes the
// original once-per-session rule). Interior routes never render this component; they
// will get a separate, subtler header-only animation (spec to follow).
// Retime only via CFG and t. Do not rewrite the animation logic.
//
// The mark's brushed-metal texture is the site's logo webp referenced as a
// built asset, not inlined base64: the base64 form was 93 KB, 57% of the
// home document, and could never be cached across visits. The intro start
// waits for this image (see the readiness gate at the bottom), so the
// rings never draw untextured.
import logoTexture from '../assets/logo/mh-pharmapack-logo.webp?url';
---

<link rel="preload" as="image" href={logoTexture} />

<script is:inline>
  // Every load of the home route plays the intro; the class gates the overlay CSS
  // and hides the site shell until the mark docks into the header.
  document.documentElement.classList.add('intro-pending');
  // Stall safety: if the intro has not docked after 7s of the page being
  // VISIBLE (script failed to load, an exception mid-animation, anything),
  // reveal the site instead of leaving the visitor on a blank sheet forever.
  // Visible time only: in a hidden or occluded tab requestAnimationFrame
  // never fires, so the intro legitimately waits for focus; a wall-clock
  // timer there would tear the intro down before anyone saw it. The timer
  // re-arms from zero whenever the tab becomes visible. A successful dock
  // sets __mhIntroDone and the firing becomes a no-op.
  (function () {
    var stallTimer = null;
    function fire() {
      if (window.__mhIntroDone) return;
      document.documentElement.classList.remove('intro-pending');
      ['sheet', 'lockup', 'replay'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.remove();
      });
      window.__mhIntroDone = true;
      dispatchEvent(new Event('mh:intro-done'));
    }
    function arm() {
      if (stallTimer) { clearTimeout(stallTimer); stallTimer = null; }
      if (window.__mhIntroDone) return;
      if (document.visibilityState === 'visible') stallTimer = setTimeout(fire, 7000);
    }
    document.addEventListener('visibilitychange', arm);
    arm();
  })();
</script>

