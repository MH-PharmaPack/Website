---
import { WHATSAPP_HREF, TEL_HREF, WHATSAPP, PHONE, withBase } from '../config';
---

<!-- Mobile-only sticky action bar: WhatsApp, Call, Request Quote. Dissolves on desktop (header CTAs take over). -->
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-paper pb-[env(safe-area-inset-bottom)] md:hidden"
  aria-label="Quick actions"
>
  <div class="grid grid-cols-3">
    <a
      href={WHATSAPP_HREF}
      class="flex min-h-14 flex-col items-center justify-center gap-1 text-xs font-semibold text-steel-deep"
      title={WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number to be added'}
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 3.75a8.25 8.25 0 0 0-7.1 12.45L3.75 20.25l4.2-1.1A8.25 8.25 0 1 0 12 3.75Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
        <path
          d="M9.3 8.9c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.5l-.5.6c-.1.2-.1.3 0 .5.4.7 1.2 1.5 2 1.9.2.1.4.1.5-.1l.5-.6c.2-.2.3-.2.5-.1l1.6.7c.3.1.4.3.4.5-.1.9-.8 1.6-1.7 1.6-2.6 0-6-2.7-6-5.6 0-.5.1-1 .2-1.4Z"
          fill="currentColor"></path>
      </svg>
      WhatsApp
    </a>
    <a
      href={TEL_HREF}
      class="flex min-h-14 flex-col items-center justify-center gap-1 border-x border-line text-xs font-semibold text-steel-deep"
      title={PHONE ? 'Call us' : 'Phone number to be added'}
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M5.1 4.5h3l1.4 3.6-1.8 1.4a11.3 11.3 0 0 0 4.8 4.8l1.4-1.8 3.6 1.4v3a1.5 1.5 0 0 1-1.6 1.5C9.6 18 6 14.4 5.6 8.1 5.5 6 4.9 5.6 5.1 4.5Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
      </svg>
      Call
    </a>
    <a href={withBase('/contact')} class="flex min-h-14 flex-col items-center justify-center gap-1 bg-copper text-xs font-semibold text-white">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M7.5 3.75h6.75L18.75 8.25v12H7.5v-16.5Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
        <path d="M10.25 12h5m-5 3h5m-5-6h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      Request Quote
    </a>
  </div>
</div>
