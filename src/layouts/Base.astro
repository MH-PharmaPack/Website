---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Seo from '../components/Seo.astro';
import type { Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Page name for structured data; defaults to the title minus the brand. */
  name?: string;
  /** WebPage subtype: ContactPage, AboutPage, CollectionPage, ProfilePage. */
  pageType?: string;
  /** Two or more crumbs emits a BreadcrumbList rich result. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes merged into this page's @graph. */
  schema?: Record<string, unknown>[];
  /** @id of the node this page is primarily about, if not the organisation. */
  mainEntityId?: string;
  noindex?: boolean;
}

const { title, description, name, pageType, breadcrumbs, schema, mainEntityId, noindex } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Titles, canonical, robots, Open Graph, Twitter, favicons, font preload,
        and the page's JSON-LD graph all live in one component so a page cannot
        ship with half a head. See src/components/Seo.astro. */}
    <Seo
      title={title}
      description={description}
      name={name}
      pageType={pageType}
      breadcrumbs={breadcrumbs}
      schema={schema}
      mainEntityId={mainEntityId}
      noindex={noindex}
    />
  </head>
  <body class="pb-20 md:pb-0">
    <!-- Intro overlay (home page only) renders here, before the shell, so its gate runs first -->
    <slot name="pre-shell" />
    <div id="site-shell">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-sm focus:bg-steel-deep focus:px-4 focus:py-2 focus:text-paper"
      >
        Skip to content
      </a>
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
      <StickyBar />
    </div>
  </body>
</html>
