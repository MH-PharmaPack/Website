---
import Base from '../layouts/Base.astro';
import EnquiryTray from '../components/EnquiryTray.astro';
import { Image } from 'astro:assets';
import { MAILTO_HREF, WHATSAPP_HREF, TEL_HREF, WHATSAPP, PHONE, withBase } from '../config';
import { sourcingService } from '../lib/seo';
import { TAXONOMY } from '../data/catalogue';
import { ITEMS, placeOf, imageFor, scopeHref } from '../lib/catalogue';
import { SOURCING_LINES, LINE_PAGE } from '../data/lines';

// WHAT WE SOURCE (CONTENT-SPEC section 6). The frame on this page is
// non-negotiable: everything below is what MH sources through its network,
// never what it makes (guardrails 5 and 6). The section header is
// "What we can source", never "Our products".
//
// Three sourcing lines since 2026-09-23 (API, Finished Formulations,
// Packaging). End-to-end sourcing stopped being a line and is described as
// the service around every order, on What We Do.
//
// The item-by-item catalogue has its own page, /catalogue/ (client decision
// 2026-09-23). This page is the overview: the three lines, then a strip of
// photo tiles, one per packaging group, each opening the catalogue at that
// group.

// The three sourcing lines (src/data/lines.ts, shared site wide), in the
// client's order. Every category printed on a tile also goes into this
// page's OfferCatalog, and nothing else does.
const lines = SOURCING_LINES;

// CONTENT-SPEC 6.3. [NEEDS: optional, any specific country detail per region.]
// Left out until the client provides it; the approval standard is the card.
const regions = [
  { name: 'India', copy: 'The core manufacturing base.' },
  { name: 'Latin America', copy: 'EU-approved facilities.' },
  { name: 'South Africa', copy: 'WHO GMP and PIC/S approved facilities.' },
];

// ---- The packaging tiles --------------------------------------------------
// One tile per packaging group, in taxonomy order, each with a few of its
// own catalogue photographs. The first group gets the large tile. `photo`
// marks a scene photograph (the pallets), which is shown framed rather than
// cut out on white.
const tileArt: Record<string, { images: string[]; photo?: boolean }> = {
  bottles: {
    images: [
      '100-ml-boston-round-pet-bottle.jpg',
      '60-ml-dome-pet-bottle.jpg',
      '100-ml-dsb-round-bottle.jpg',
      '10-ml-dropper-bottle.jpg',
    ],
  },
  closures: { images: ['25-mm-crc-outer.jpg', 'flip-top-cap-lens-cleaner-bottle.jpg'] },
  'vial-seals': { images: ['flip-off-seal.jpg'] },
  flexible: { images: ['standard-pouch.jpg'] },
  pallets: { images: ['pallet-nestable.jpg'], photo: true },
};
const packaging = TAXONOMY.find((l) => l.id === 'packaging');
const packagingItems = ITEMS.filter((i) => placeOf(i).line.id === 'packaging');
const tiles = (packaging?.groups ?? [])
  .map((g) => ({
    ...g,
    href: scopeHref({ line: 'packaging', group: g.id }),
    count: ITEMS.filter((i) => placeOf(i).group.id === g.id).length,
    typeCount: g.types?.length ?? 0,
    art: tileArt[g.id] ?? { images: [] },
  }))
  .filter((t) => t.count > 0);

// Title: nav anchor first, then the four concrete lines, brand last, same
// pattern as the leadership page. The lines are the phrases a buyer would
// search; the brand is the part that survives truncation least usefully.
//
// Description: the range, the standard, and the regions in the first sentence,
// the sourced-not-made frame in the second.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Base
  title="What We Source: API, Formulations, Packaging | MH PharmaPack"
  name="What we source"
  description="API, finished formulations and pharmaceutical packaging, sourced through WHO GMP and EU GMP approved plants in India, Latin America and South Africa."
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'What We Source' }]}
  schema={[
    sourcingService(
      [
        ...lines.map((l) => ({ name: l.name, items: l.categories })),
        ...tiles.map((t) => ({ name: t.name })),
      ],
      pageUrl,
      Astro.site,
    ),
  ]}
  mainEntityId={`${pageUrl}#service`}
>
  <!-- The catalogue used to live on this page. Links into it (the ?group=
       style filters, the old ?cat= ones, #catalogue) now go to /catalogue/
       with the same filters. Inline and early so there is no flash of the
       wrong page. -->
  <script is:inline define:vars={{ catalogue: withBase('/catalogue') }}>
    (function () {
      var p = new URLSearchParams(location.search);
      var keys = ['line', 'group', 'type', 'q', 'mat', 'cat', 'sort'];
      var linked = keys.some(function (k) { return p.has(k); });
      if (linked || location.hash === '#catalogue') location.replace(catalogue + location.search);
    })();
  </script>

  <!-- 6.1 Intro. The paragraph is verbatim spec copy; the headline is authored
       to say only what that paragraph already says. [NEEDS: confirm headline] -->
  <section class="bg-paper">
    <div class="mx-auto max-w-content px-5 pt-12 pb-10 md:px-8 md:pt-16 md:pb-14">
      <p class="eyebrow" data-reveal>What we source</p>
      <h1 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        What we source, and where it comes from.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-steel-deep" data-reveal>
        Through our network of approved manufacturing partners, we source across the
        pharmaceutical supply chain. The range below reflects what we can source for you; it is
        not in-house manufacturing. Every partner plant is quality-approved, and we source
        exclusively from WHO GMP and EU GMP approved facilities.
      </p>
      <div class="mt-7 flex flex-wrap gap-3" data-reveal>
        <a href={withBase('/catalogue')} class="btn btn-primary">Browse the catalogue</a>
        <a href={withBase('/contact')} class="btn btn-secondary">Request a Quote</a>
      </div>
    </div>
  </section>

  <!-- 6.2 The three lines. One tile per line with its categories set as a
       short run of text: three across on a tablet or desktop, a swipeable
       rail on a phone (each tile shows the edge of the next, which is the cue
       to swipe). The end-to-end service that used to be a fourth tile is the
       sentence under the rail, pointing to What We Do. -->
  <section class="border-t border-line bg-paper" id="lines">
    <div class="mx-auto max-w-content px-5 py-12 md:px-8 md:py-16">
      <p class="eyebrow" data-reveal>The sourcing matrix</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        What we can source.
      </h2>
      <ul class="lines-rail mt-8 md:mt-10" aria-label="The three sourcing lines">
        {
          lines.map((line) => (
            <li class="lines-tile" data-reveal-child>
              <svg class="h-7 w-7 text-copper-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={line.icon} />
              <h3 class="mt-4 text-lg font-bold tracking-tight text-ink">{line.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-steel-deep">{line.summary}</p>
              {line.categories.length > 0 && (
                <p class="mt-3 text-sm leading-relaxed text-ink">{line.categories.join(' · ')}</p>
              )}
              {line.note && <p class="mt-2 text-sm leading-relaxed text-steel-deep">{line.note}</p>}
              <a href={withBase(LINE_PAGE[line.id].path)} class="lines-link">
                {LINE_PAGE[line.id].linkText}
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m10 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-2xl text-base leading-relaxed text-steel-deep" data-reveal>
        Any one line, or all three for a single programme, sourced end to end: we match the right
        approved plant and coordinate every step from first enquiry to delivered goods.{' '}
        <a href={withBase('/services')} class="font-semibold text-copper-deep underline underline-offset-4 hover:text-copper">
          How we work
        </a>
      </p>
    </div>
  </section>

  <!-- The packaging range as photo tiles (the one piece of "concept B" kept,
       client decision 2026-09-23). Each tile opens the catalogue at its
       group. Heading and line authored. [NEEDS: confirm copy] -->
  <section class="border-t border-line bg-paper-warm" id="packaging-range">
    <div class="mx-auto max-w-content px-5 py-12 md:px-8 md:py-16">
      <p class="eyebrow" data-reveal>Sourcing catalogue</p>
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
            Browse the packaging range.
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-steel-deep" data-reveal>
            {packagingItems.length} items from approved partner plants, each with its specification
            and an enquiry button.
          </p>
        </div>
        <a href={withBase('/catalogue')} class="btn btn-secondary shrink-0 self-start md:self-auto" data-reveal>
          Open the full catalogue
        </a>
      </div>

      <ul class="tiles mt-8 md:mt-10">
        {
          tiles.map((t, i) => (
            <li class:list={['tile-li', { 'tile-big': i === 0 }]} data-reveal-child>
              <a href={t.href} class="tile">
                <span class:list={['tile-art', { 'tile-art-photo': t.art.photo }]}>
                  {t.art.images.map((file) => (
                    <Image
                      src={imageFor(file)}
                      alt=""
                      width={i === 0 ? 320 : 240}
                      densities={[1, 2]}
                      format="webp"
                      quality={78}
                      loading="lazy"
                    />
                  ))}
                </span>
                <span class="tile-label">
                  <span class="tile-name">{t.name}</span>
                  <span class="tile-n">
                    {t.count} item{t.count === 1 ? '' : 's'}
                    {t.typeCount > 1 ? ` · ${t.typeCount} types` : ''}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-steel-deep" data-reveal>
        API and finished formulations are being added to the catalogue.
      </p>
    </div>
  </section>

  <!-- 6.3 Sourcing regions: three clean cards, each noting the approval
       standard. Heading authored; it adds no claim. [NEEDS: confirm headline] -->
  <section class="border-t border-line bg-paper">
    <div class="mx-auto max-w-content px-5 py-12 md:px-8 md:py-16">
      <p class="eyebrow" data-reveal>Sourcing regions</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Where we source.
      </h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3 md:mt-10 md:gap-6">
        {
          regions.map((region) => (
            <div class="rounded-sm border border-line bg-white p-6 md:p-7" data-reveal-child>
              <h3 class="text-lg font-bold tracking-tight text-ink">{region.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-steel-deep">{region.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6.4 Quality and approvals. Verbatim, attribution-safe, and deliberately
       plain text: no badge row, because the approvals belong to the partner
       plants, not to MH (guardrail 2). Quiet-statement pattern on the navy
       band, echoing the home page's proof sections. -->
  <section class="band band-weave">
    <div class="mx-auto max-w-content px-5 py-16 md:px-8 md:py-24">
      <p class="eyebrow eyebrow-on-dark" data-reveal>Quality and approvals</p>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed font-medium text-paper md:text-xl" data-reveal>
        We source exclusively from WHO GMP and EU GMP approved plants. Our partner facilities
        hold WHO GMP, EU GMP, ISO, and UK MHRA approvals. MH PharmaPack coordinates quality
        documentation between buyer and supplier; the approvals belong to the manufacturing
        partners.
      </p>
    </div>
  </section>

  <!-- 6.5 CTA -->
  <section class="bg-paper">
    <div class="mx-auto max-w-content px-5 py-20 text-center md:px-8 md:py-28">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Looking for something specific?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-steel-deep" data-reveal>
        Tell us the molecule, the format, and the market.
      </p>
      <div class="mt-9" data-reveal>
        <a href={withBase('/contact')} class="btn btn-primary">Request a Quote</a>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm font-semibold" data-reveal>
        <a
          href={WHATSAPP_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number to be added'}
        >
          WhatsApp
        </a>
        <a
          href={TEL_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={PHONE ? 'Call us' : 'Phone number to be added'}
        >
          Call
        </a>
        <a href={MAILTO_HREF} class="text-steel-deep transition-colors hover:text-ink">Email</a>
      </div>
    </div>
  </section>

  <EnquiryTray />

  <style>
    /* ---- The three-line rail ----------------------------------------- */
    /* Phone: a horizontal snap rail bleeding to the screen edges, each tile
       78% wide so the next one peeks in. Tablet and desktop: three across. */
    .lines-rail {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: min(78%, 19rem);
      gap: 0.75rem;
      margin: 2rem -1.25rem 0;
      padding: 0 1.25rem 0.25rem;
      list-style: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.25rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .lines-rail::-webkit-scrollbar {
      display: none;
    }
    .lines-tile {
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--color-line);
      border-radius: 0.25rem;
      background: #ffffff;
      padding: 1.25rem;
    }
    .lines-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-top: auto;
      padding-top: 1rem;
      min-height: 2.75rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--color-copper-deep);
      text-decoration: none;
    }
    .lines-link:hover {
      color: var(--color-copper);
    }
    @media (min-width: 768px) {
      .lines-rail {
        grid-auto-flow: row;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin: 2.5rem 0 0;
        padding: 0;
        overflow: visible;
      }
    }
    @media (min-width: 1024px) {
      .lines-rail {
        gap: 1.25rem;
      }
      .lines-tile {
        padding: 1.75rem 1.5rem;
      }
    }

    /* ---- Packaging tiles --------------------------------------------- */
    /* Phone: the first group full width, the rest two across. Desktop: a
       bento, the first group tall on the left and four tiles beside it. */
    .tiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.625rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .tile-big {
      grid-column: 1 / -1;
    }
    .tile {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 10rem;
      border: 1px solid var(--color-line);
      border-radius: 0.5rem;
      background: #ffffff;
      overflow: hidden;
      color: var(--color-ink);
      text-decoration: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .tile:hover,
    .tile:focus-visible {
      border-color: var(--color-steel);
      box-shadow: 0 14px 30px -20px rgba(38, 48, 61, 0.5);
    }
    .tile-big .tile {
      background: linear-gradient(180deg, #ffffff 0%, #eef1f4 100%);
    }
    .tile-art {
      flex: 1;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 0.75rem 0.5rem 0;
      min-height: 6.5rem;
    }
    .tile-art :global(img) {
      height: 6.5rem;
      width: auto;
      object-fit: contain;
      mix-blend-mode: multiply;
    }
    /* The photos are square with the bottle in the middle third, so they
       overlap generously; multiply blending makes the white overlap vanish. */
    .tile-big .tile-art :global(img) {
      height: 9.5rem;
      margin: 0 -2.4rem;
    }
    .tile-art-photo {
      align-items: center;
      padding: 0.75rem 0.75rem 0;
    }
    .tile-art-photo :global(img) {
      height: 6rem;
      border-radius: 0.25rem;
      mix-blend-mode: normal;
    }
    .tile-label {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.75rem 0.9rem 0.9rem;
    }
    .tile-name {
      font-size: 0.9375rem;
      font-weight: 700;
      line-height: 1.25;
    }
    .tile-big .tile-name {
      font-size: 1.25rem;
    }
    .tile-n {
      flex: none;
      font-size: 0.75rem;
      color: var(--color-steel-deep);
    }
    @media (max-width: 400px) {
      /* Two-up tiles at the 344px floor: name over count, not beside it. */
      .tile-li:not(.tile-big) .tile-label {
        flex-direction: column;
        gap: 0.15rem;
      }
    }
    @media (min-width: 1024px) {
      .tiles {
        grid-template-columns: 1.6fr 1fr 1fr;
        grid-template-rows: 12rem 12rem;
        gap: 0.875rem;
      }
      .tile-big {
        grid-column: 1;
        grid-row: 1 / span 2;
      }
      .tile-art :global(img) {
        height: 7.5rem;
      }
      .tile-big .tile-art :global(img) {
        height: 16rem;
        margin: 0 -4rem;
      }
      .tile-art-photo :global(img) {
        height: 7.5rem;
      }
      .tile-big .tile-name {
        font-size: 1.625rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .tile {
        transition: none;
      }
    }
  </style>

  <script>
    import initPageFlow from '../scripts/page-flow.js';
    initPageFlow();
  </script>
</Base>
