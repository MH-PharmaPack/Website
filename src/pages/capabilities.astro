---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { MAILTO_HREF, WHATSAPP_HREF, TEL_HREF, WHATSAPP, PHONE, withBase } from '../config';
import { sourcingService } from '../lib/seo';
import { CATALOGUE, CATALOGUE_CATEGORIES } from '../data/catalogue';

// WHAT WE SOURCE (CONTENT-SPEC section 6). The frame on this page is
// non-negotiable: everything below is what MH sources through its network,
// never what it makes (guardrails 5 and 6). The section header is
// "What we can source", never "Our products".
//
// Category lists are the final ones from CONTENT-SPEC 5.2. `items` feeds this
// page's OfferCatalog JSON-LD and holds only phrases printed visibly in the
// matrix below, same rule as the home page: if a category leaves the page, it
// leaves the list.

const lines = [
  {
    name: 'Packaging',
    summary: 'Primary and secondary packaging, sourced to specification.',
    categories: [
      'Vials',
      'Ampoules',
      'Rubber stoppers and closures',
      'Cartons and mono cartons',
      'Flexible pouches',
      'Blister foils',
      'Aluminium blister foils',
      'Alu-alu foil',
      'Labels (paper, shrink)',
      'Flexible laminates',
    ],
    note: '',
    icon: '<path d="M4.5 8 12 4.25 19.5 8v8L12 19.75 4.5 16V8Z" stroke-linejoin="round"/><path d="M4.5 8 12 11.75 19.5 8" stroke-linejoin="round"/><path d="M12 11.75v8" stroke-linecap="round"/>',
  },
  {
    name: 'Formulation',
    summary: 'Formulation development and supply across major lines.',
    categories: [
      'OSD (oral solid dosage)',
      'General formulation',
      'Cephalosporins',
      'Beta-lactams',
    ],
    note: 'Across all major formulation types.',
    icon: '<path d="M10 4h4" stroke-linecap="round"/><path d="M10.75 4v5l-4.4 7.5A2.1 2.1 0 0 0 8.2 19.7h7.6a2.1 2.1 0 0 0 1.85-3.2L13.25 9V4" stroke-linejoin="round"/><path d="M8.4 14.5h7.2" stroke-linecap="round"/>',
  },
  {
    name: 'Finished Goods',
    summary: 'Finished dosage forms, ready for your market.',
    categories: ['Injectables', 'Tablets and capsules', 'Liquids', 'Dry powders'],
    note: '',
    icon: '<path d="M7.3 7.3a3.9 3.9 0 0 1 5.5 0l3.9 3.9a3.9 3.9 0 1 1-5.5 5.5l-3.9-3.9a3.9 3.9 0 0 1 0-5.5Z" stroke-linejoin="round"/><path d="m10.05 10.05 3.9 3.9" stroke-linecap="round"/>',
  },
  {
    name: 'API',
    summary: 'Active pharmaceutical ingredients across therapeutic categories.',
    categories: ['Corticosteroids', 'Anticancer', 'Antidepressants'],
    note: 'And most major API categories.',
    icon: '<path d="M12 4 19 8v8l-7 4-7-4V8l7-4Z" stroke-linejoin="round"/><circle cx="12" cy="12" r="1.6"/>',
  },
  {
    name: 'Sourcing',
    summary: 'The connecting service that ties it together.',
    categories: [],
    note: 'One line or all five, matched to the right approved plant, for buyers and for suppliers seeking demand.',
    icon: '<path d="m9.5 14.5 5-5" stroke-linecap="round"/><path d="M11 7.5 12.7 5.8a3.4 3.4 0 0 1 4.8 4.8L15.8 12.3" stroke-linecap="round"/><path d="M13 16.5 11.3 18.2a3.4 3.4 0 0 1-4.8-4.8l1.7-1.7" stroke-linecap="round"/>',
  },
];

// CONTENT-SPEC 6.3. [NEEDS: optional, any specific country detail per region.]
// Left out until the client provides it; the approval standard is the card.
const regions = [
  { name: 'India', copy: 'The core manufacturing base.' },
  { name: 'Latin America', copy: 'EU-approved facilities.' },
  { name: 'South Africa', copy: 'WHO GMP and PIC/S approved facilities.' },
];

// The catalogue's images live in src/assets/catalogue/ and are looked up by
// the filename each data entry carries. A missing file fails the build here,
// loudly, rather than shipping a card with a broken image.
const catalogueImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/catalogue/*.{jpg,png,svg}',
  { eager: true },
);
const imageFor = (file: string): ImageMetadata => {
  const mod = catalogueImages[`../assets/catalogue/${file}`];
  if (!mod) throw new Error(`catalogue image missing: ${file}`);
  return mod.default;
};

// Everything the client-side search matches against, precomputed per card.
// keywords are industry synonyms (e.g. "child resistant" for CRC) that are
// searchable but never displayed.
const searchText = (item: (typeof CATALOGUE)[number]) =>
  [item.name, item.category, item.material, item.weight, item.keywords]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

// The catalogue's categories and item names join the page's OfferCatalog:
// every name is printed on a visible card below, so the markup keeps to the
// visible-words rule.
const catalogueLines = CATALOGUE_CATEGORIES.map((cat) => ({
  name: cat,
  items: CATALOGUE.filter((i) => i.category === cat).map((i) => i.name),
}));

// Title: nav anchor first, then the four concrete lines, brand last, same
// pattern as the leadership page. The lines are the phrases a buyer would
// search; the brand is the part that survives truncation least usefully.
//
// Description: the range, the standard, and the regions in the first sentence,
// the sourced-not-made frame in the second.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Base
  title="What We Source: Packaging, Formulation, Finished Goods, API | MH PharmaPack"
  name="What we source"
  description="Packaging, formulation, finished dosage forms and API, sourced through WHO GMP and EU GMP approved plants in India, Latin America and South Africa. Browse the searchable packaging catalogue: caps, closures, bottles and more."
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'What We Source' }]}
  schema={[
    sourcingService(
      [...lines.map((l) => ({ name: l.name, items: l.categories })), ...catalogueLines],
      pageUrl,
      Astro.site,
    ),
  ]}
  mainEntityId={`${pageUrl}#service`}
>
  <!-- 6.1 Intro. The paragraph is verbatim spec copy; the headline is authored
       to say only what that paragraph already says. [NEEDS: confirm headline] -->
  <section class="bg-paper">
    <div class="mx-auto max-w-content px-5 pt-14 pb-12 md:px-8 md:pt-20 md:pb-16">
      <p class="eyebrow" data-reveal>What we source</p>
      <h1 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        What we source, and where it comes from.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-steel-deep" data-reveal>
        Through our network of approved manufacturing partners, we source across the
        pharmaceutical supply chain. The range below reflects what we can source for you; it is
        not in-house manufacturing. Every partner plant is quality-approved, and we source
        exclusively from WHO GMP and EU GMP approved facilities.
      </p>
    </div>
  </section>

  <!-- 6.2 The sourcing matrix. Mobile: an accordion, one line per expandable
       section (CLAUDE.md hard requirement, never a mega-grid). Desktop: every
       line open, name and summary in the left column, categories in the right,
       laid out for scanning. One DOM serves both: the toggle stays functional
       at every width, only the default state differs, so aria-expanded is
       always telling the truth. Without JS everything is simply open. -->
  <section class="border-t border-line bg-paper">
    <div class="mx-auto max-w-content px-5 py-14 md:px-8 md:py-20">
      <p class="eyebrow" data-reveal>The sourcing matrix</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        What we can source.
      </h2>
      <div class="mt-10 border-t border-line md:mt-12" data-matrix>
        {
          lines.map((line, i) => (
            <div class="border-b border-line md:grid md:grid-cols-[minmax(0,21rem)_1fr] md:items-start md:gap-x-12 lg:gap-x-16" data-matrix-row data-reveal-child>
              <h3 class="m-0">
                <button
                  type="button"
                  class="matrix-toggle block w-full py-5 text-left md:py-7"
                  aria-expanded="true"
                  aria-controls={`line-panel-${i}`}
                >
                  <span class="flex items-center gap-3">
                    <svg class="h-6 w-6 shrink-0 text-copper-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={line.icon} />
                    <span class="flex-1 text-lg font-bold tracking-tight text-ink md:text-xl">{line.name}</span>
                    <svg class="matrix-chevron h-5 w-5 shrink-0 text-steel-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="m6 9.5 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="mt-1.5 block pl-9 text-sm leading-relaxed text-steel-deep">
                    {line.summary}
                  </span>
                </button>
              </h3>
              <div class="matrix-panel" id={`line-panel-${i}`}>
                <div class="matrix-panel-clip">
                  <div class="pb-6 pl-9 md:py-7 md:pl-0">
                    {line.categories.length > 0 && (
                      <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                        {line.categories.map((cat) => (
                          <li class="inline-flex items-center rounded-sm border border-line bg-paper-warm px-3 py-1.5 text-sm text-steel-deep">
                            {cat}
                          </li>
                        ))}
                      </ul>
                    )}
                    {line.note && (
                      <p class={`${line.categories.length ? 'mt-3' : 'mt-0'} max-w-xl text-sm leading-relaxed text-steel-deep`}>
                        {line.note}
                      </p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The sourcing catalogue: partner-plant packaging items, searchable and
       filterable client side. Data in src/data/catalogue.ts; the partner is
       deliberately unnamed (see the note there). Framing stays "what we
       source", never "our products" (guardrails 5 and 6). Controls are hidden
       until the script arms them, so without JS the full catalogue is simply
       visible with nothing interactive lying dead. -->
  <section class="border-t border-line bg-paper" id="catalogue">
    <div class="mx-auto max-w-content px-5 py-14 md:px-8 md:py-20">
      <p class="eyebrow" data-reveal>Sourcing catalogue</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        The packaging range, item by item.
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-steel-deep" data-reveal>
        Every item below is sourced through our partner network and supplied to your
        specification: what we source, not what we make. The catalogue grows as the network
        does.
      </p>

      <div class="mt-9" data-cat-controls hidden>
        <label class="relative block max-w-md">
          <span class="sr-only">Search the catalogue</span>
          <svg
            class="pointer-events-none absolute top-1/2 left-4 h-4 w-4 -translate-y-1/2 text-steel-deep"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m15.5 15.5 4.5 4.5" stroke-linecap="round" />
          </svg>
          <input
            id="cat-search"
            type="search"
            autocomplete="off"
            placeholder="Search: item, size, material"
            class="w-full rounded-sm border border-line bg-white py-3 pr-4 pl-11 text-base text-ink transition-colors placeholder:text-muted focus:border-steel focus:outline-none"
          />
        </label>
        <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter by category">
          <button type="button" class="cat-chip" data-cat-filter="all" aria-pressed="true">
            All categories
          </button>
          {
            CATALOGUE_CATEGORIES.map((c) => (
              <button type="button" class="cat-chip" data-cat-filter={c} aria-pressed="false">
                {c}
              </button>
            ))
          }
        </div>
        <div class="mt-2.5 flex flex-wrap gap-2" role="group" aria-label="Filter by material">
          <button type="button" class="cat-chip" data-mat-filter="all" aria-pressed="true">
            All materials
          </button>
          {
            ['PP', 'HDPE', 'LDPE'].map((m) => (
              <button
                type="button"
                class="cat-chip"
                data-mat-filter={m.toLowerCase()}
                aria-pressed="false"
              >
                {m}
              </button>
            ))
          }
        </div>
        <p class="mt-5 text-sm font-semibold text-steel-deep" data-cat-count aria-live="polite">
        </p>
      </div>

      <ul
        class="mt-6 grid list-none grid-cols-2 gap-x-3 gap-y-6 p-0 sm:grid-cols-3 md:gap-x-4 lg:grid-cols-4 xl:grid-cols-5"
        data-cat-grid
      >
        {
          CATALOGUE.map((item) => (
            <li
              data-cat-item
              data-cat={item.category}
              data-mat={(item.material ?? '').toLowerCase()}
              data-search={searchText(item)}
            >
              <figure class="m-0 flex aspect-square items-center justify-center overflow-hidden rounded-sm border border-line bg-white p-3 md:p-4">
                {item.illustrative ? (
                  <img
                    src={imageFor(item.image).src}
                    alt={`${item.name}, representative illustration`}
                    class="h-full w-full scale-[1.32] object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={imageFor(item.image)}
                    alt={item.name}
                    width={360}
                    densities={[1, 2]}
                    format="webp"
                    quality={80}
                    class="h-full w-full object-contain"
                    loading="lazy"
                  />
                )}
              </figure>
              <p class="mt-2.5 text-[13px] leading-snug font-semibold text-ink md:text-sm">
                {item.name}
              </p>
              {(item.material || item.weight) && (
                <p class="mt-1 text-xs text-steel-deep">
                  {[item.material, item.weight].filter(Boolean).join(' · ')}
                </p>
              )}
            </li>
          ))
        }
      </ul>

      <div class="mt-10 text-center" data-cat-more-wrap hidden>
        <button type="button" class="btn btn-secondary" data-cat-more>Show all items</button>
      </div>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-steel-deep" data-cat-empty hidden>
        Nothing in the catalogue matches{' '}
        <span class="font-semibold text-ink" data-cat-empty-q></span>. We can very likely still
        source it:{' '}
        <a
          href={withBase('/contact')}
          class="font-semibold text-copper-deep underline underline-offset-4 hover:text-copper"
        >
          tell us what you need
        </a>.
      </p>
    </div>
  </section>

  <!-- 6.3 Sourcing regions: three clean cards, each noting the approval
       standard. Heading authored; it adds no claim. [NEEDS: confirm headline] -->
  <section class="border-t border-line bg-paper-warm">
    <div class="mx-auto max-w-content px-5 py-14 md:px-8 md:py-20">
      <p class="eyebrow" data-reveal>Sourcing regions</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Where we source.
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-3 md:mt-12 md:gap-6">
        {
          regions.map((region) => (
            <div class="rounded-sm border border-line bg-paper p-6 md:p-7" data-reveal-child>
              <h3 class="text-lg font-bold tracking-tight text-ink">{region.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-steel-deep">{region.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6.4 Quality and approvals. Verbatim, attribution-safe, and deliberately
       plain text: no badge row, because the approvals belong to the partner
       plants, not to MH (guardrail 2). Quiet-statement pattern on the navy
       band, echoing the home page's proof sections. -->
  <section class="band band-weave">
    <div class="mx-auto max-w-content px-5 py-16 md:px-8 md:py-24">
      <p class="eyebrow eyebrow-on-dark" data-reveal>Quality and approvals</p>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed font-medium text-paper md:text-xl" data-reveal>
        We source exclusively from WHO GMP and EU GMP approved plants. Our partner facilities
        hold WHO GMP, EU GMP, ISO, and UK MHRA approvals. MH PharmaPack coordinates quality
        documentation between buyer and supplier; the approvals belong to the manufacturing
        partners.
      </p>
    </div>
  </section>

  <!-- 6.5 CTA -->
  <section class="bg-paper">
    <div class="mx-auto max-w-content px-5 py-20 text-center md:px-8 md:py-28">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Looking for something specific?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-steel-deep" data-reveal>
        Tell us the molecule, the format, and the market.
      </p>
      <div class="mt-9" data-reveal>
        <a href={withBase('/contact')} class="btn btn-primary">Request a Quote</a>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm font-semibold" data-reveal>
        <a
          href={WHATSAPP_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number to be added'}
        >
          WhatsApp
        </a>
        <a
          href={TEL_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={PHONE ? 'Call us' : 'Phone number to be added'}
        >
          Call
        </a>
        <a href={MAILTO_HREF} class="text-steel-deep transition-colors hover:text-ink">Email</a>
      </div>
    </div>
  </section>

  <style>
    /* Accordion mechanics. The collapsed state exists only under .js-acc, which
       the script below adds, so without JS every panel is simply open. The
       0fr/1fr grid transition animates to content height with no measuring;
       the clip wrapper provides the min-height:0 the trick requires. */
    .matrix-panel {
      display: grid;
      grid-template-rows: 1fr;
      transition:
        grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0s;
    }
    .matrix-panel-clip {
      min-height: 0;
      overflow: hidden;
    }
    .js-acc [data-matrix-row]:not(.is-open) .matrix-panel {
      grid-template-rows: 0fr;
      /* Collapsed content leaves the a11y tree and the hit-test area, not just
         the viewport. The delay holds visibility until the fold finishes. */
      visibility: hidden;
      transition:
        grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.45s;
    }
    .matrix-chevron {
      transition: transform 0.3s ease;
    }
    [data-matrix-row].is-open .matrix-chevron {
      transform: rotate(180deg);
    }

    /* Catalogue filter chips. 44px minimum height is the mobile tap-target
       floor (CLAUDE.md), not a style choice. Active state mirrors the site's
       steel-deep on paper inversion. */
    .cat-chip {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0 1rem;
      border: 1px solid var(--color-line);
      border-radius: 0.25rem;
      background: #ffffff;
      color: var(--color-steel-deep);
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    }
    .cat-chip:hover {
      border-color: var(--color-steel);
      color: var(--color-ink);
    }
    .cat-chip[aria-pressed='true'] {
      background: var(--color-steel-deep);
      border-color: var(--color-steel-deep);
      color: var(--color-paper);
    }

    @media (prefers-reduced-motion: reduce) {
      .matrix-panel,
      .js-acc [data-matrix-row]:not(.is-open) .matrix-panel,
      .matrix-chevron,
      .cat-chip {
        transition: none;
      }
    }
  </style>

  <script>
    import initPageFlow from '../scripts/page-flow.js';
    initPageFlow();

    // The matrix accordion. Toggles work at every width; only the defaults
    // differ. Mobile opens the first line so the pattern is self-explaining,
    // desktop opens everything because the spec wants the range scannable.
    const matrix = document.querySelector('[data-matrix]');
    const rows = [...document.querySelectorAll<HTMLElement>('[data-matrix-row]')];
    const mq = window.matchMedia('(min-width: 768px)');

    const setRow = (row: HTMLElement, open: boolean) => {
      row.classList.toggle('is-open', open);
      row.querySelector('.matrix-toggle')?.setAttribute('aria-expanded', String(open));
    };

    if (matrix && rows.length) {
      // Arm only once we know we can control it: a JS failure leaves the
      // matrix fully open rather than locked shut.
      matrix.classList.add('js-acc');

      const applyDefaults = (desktop: boolean) => {
        rows.forEach((row, i) => setRow(row, desktop || i === 0));
      };
      applyDefaults(mq.matches);
      mq.addEventListener('change', (e) => applyDefaults(e.matches));

      for (const row of rows) {
        row.querySelector('.matrix-toggle')?.addEventListener('click', () => {
          setRow(row, !row.classList.contains('is-open'));
        });
      }
    }

    // The catalogue: substring search plus category and material filters, all
    // client side over data-* attributes, no framework. The first LIMIT
    // matches show; "Show all" reveals the rest of the current match set, and
    // any filter or search change folds back to the limit so the grid never
    // silently holds a mile of scroll. Material matching is substring on
    // purpose: an "LDPE + HDPE" item belongs under both chips.
    const grid = document.querySelector<HTMLElement>('[data-cat-grid]');
    const controls = document.querySelector<HTMLElement>('[data-cat-controls]');
    if (grid && controls) {
      const items = [...grid.querySelectorAll<HTMLElement>('[data-cat-item]')];
      const searchInput = document.getElementById('cat-search') as HTMLInputElement | null;
      const catBtns = [...controls.querySelectorAll<HTMLButtonElement>('[data-cat-filter]')];
      const matBtns = [...controls.querySelectorAll<HTMLButtonElement>('[data-mat-filter]')];
      const countEl = controls.querySelector<HTMLElement>('[data-cat-count]');
      const moreWrap = document.querySelector<HTMLElement>('[data-cat-more-wrap]');
      const moreBtn = document.querySelector<HTMLButtonElement>('[data-cat-more]');
      const emptyEl = document.querySelector<HTMLElement>('[data-cat-empty]');
      const emptyQ = document.querySelector<HTMLElement>('[data-cat-empty-q]');
      const LIMIT = 20;
      let cat = 'all';
      let mat = 'all';
      let expanded = false;

      const apply = () => {
        const q = (searchInput?.value ?? '').trim().toLowerCase();
        let matched = 0;
        let shown = 0;
        for (const el of items) {
          const ok =
            (cat === 'all' || el.dataset.cat === cat) &&
            (mat === 'all' || (el.dataset.mat ?? '').includes(mat)) &&
            (!q || (el.dataset.search ?? '').includes(q));
          if (ok) matched++;
          const visible = ok && (expanded || matched <= LIMIT);
          el.hidden = !visible;
          if (visible) shown++;
        }
        if (countEl) {
          countEl.textContent =
            matched === 0
              ? 'No matching items'
              : shown < matched
                ? `Showing ${shown} of ${matched} items`
                : `Showing all ${matched} item${matched === 1 ? '' : 's'}`;
        }
        if (moreWrap && moreBtn) {
          moreWrap.hidden = matched <= shown;
          moreBtn.textContent = `Show all ${matched} items`;
        }
        if (emptyEl) emptyEl.hidden = matched !== 0;
        if (emptyQ) emptyQ.textContent = `"${q}"`;
        grid.hidden = matched === 0;
      };

      // Arm only once we can control the grid: a JS failure leaves the whole
      // catalogue visible with no dead controls on screen.
      controls.hidden = false;

      searchInput?.addEventListener('input', () => {
        expanded = false;
        apply();
      });
      const wireGroup = (btns: HTMLButtonElement[], set: (b: HTMLButtonElement) => void) => {
        for (const b of btns) {
          b.addEventListener('click', () => {
            for (const x of btns) x.setAttribute('aria-pressed', String(x === b));
            set(b);
            expanded = false;
            apply();
          });
        }
      };
      wireGroup(catBtns, (b) => (cat = b.dataset.catFilter ?? 'all'));
      wireGroup(matBtns, (b) => (mat = b.dataset.matFilter ?? 'all'));
      moreBtn?.addEventListener('click', () => {
        expanded = true;
        apply();
      });
      apply();
    }
  </script>
</Base>
