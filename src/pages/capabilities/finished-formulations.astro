---
import Base from '../../layouts/Base.astro';
import LinePage from '../../components/LinePage.astro';
import { sourcingService } from '../../lib/seo';
import { lineById } from '../../data/lines';
import { ITEMS, placeOf, scopeHref } from '../../lib/catalogue';

// Finished Formulations line page. See src/components/LinePage.astro for
// where every section's copy comes from. The intro is the line's blurb from
// src/data/lines.ts; the "what to send" list is the quote form's own
// finished-formulation prompts (src/data/rfq.ts: dosage form, strength, pack
// size and pack style, quantity in units) plus the registration documents on
// the form's regulatory list (CTD or ACTD dossier, CoPP).
// [NEEDS: confirm headline and list]
const line = lineById('finished');
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ffCount = ITEMS.filter((i) => placeOf(i).line.id === 'finished').length;
---

<Base
  title="Finished Formulations from Approved Plants | MH PharmaPack"
  name="Finished formulations"
  description="Injectables, tablets, capsules, liquids and dry powders, including cephalosporin and beta-lactam lines, from WHO GMP and EU GMP approved plants."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'What We Source', path: '/capabilities' },
    { name: 'Finished Formulations' },
  ]}
  schema={[sourcingService([{ name: line.name, items: line.categories }], pageUrl, Astro.site)]}
  mainEntityId={`${pageUrl}#service`}
>
  <LinePage
    line={line}
    eyebrow="Finished formulations"
    headline="Finished formulations from WHO GMP and EU GMP approved plants."
    intro={`${line.blurb} Sourced through our network of approved manufacturing partners in India, Latin America, and South Africa. We do not manufacture; we source, match, and manage.`}
    ask={[
      'The product, its strength and dosage form',
      'Pack size and pack style',
      'Quantity, in units or packs',
      'The destination market and what registration needs, such as a CTD or ACTD dossier or a CoPP',
      'Your timeline',
    ]}
    categoriesNote={`${ffCount} finished formulations are listed in the catalogue so far, each with its dosage form and strengths, and more are being added.`}
    catalogue={{ href: scopeHref({ line: 'finished' }), label: `Browse the ${ffCount} formulations` }}
    ctaTitle="Looking for a specific formulation?"
    ctaLede="Tell us the product, the dosage form and the market."
  />
</Base>
