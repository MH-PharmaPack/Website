---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import CatalogueCard from '../../components/CatalogueCard.astro';
import EnquiryActions from '../../components/EnquiryActions.astro';
import EnquiryTray from '../../components/EnquiryTray.astro';
import { CATALOGUE, type CatalogueItem } from '../../data/catalogue';
import { imageFor, itemSlug, itemFacts, itemNote, placeOf, categoryName, scopeHref, ITEMS } from '../../lib/catalogue';

// One page per catalogue item. It exists so an item can be linked from a cold
// email or a WhatsApp thread and so the enquiry buttons have somewhere to
// live without JS; the catalogue's quick view shows the same facts in place.
// Framing is the same as the catalogue: what we source, never our product,
// and no Product schema for the reason given in src/lib/seo.ts.

export function getStaticPaths() {
  return CATALOGUE.map((item) => ({ params: { slug: itemSlug(item) }, props: { item } }));
}

interface Props {
  item: CatalogueItem;
}

const { item } = Astro.props;
const facts = itemFacts(item);
const note = itemNote(item);
const place = placeOf(item);
const category = categoryName(item);
// Related: the same type first, topped up from the rest of the group.
const sameType = ITEMS.filter((i) => i !== item && placeOf(i).type && placeOf(i).type === place.type);
const sameGroup = ITEMS.filter((i) => i !== item && placeOf(i).group === place.group && !sameType.includes(i));
const related = [...sameType, ...sameGroup].slice(0, 5);
const catalogueHref = scopeHref({ line: place.line.id });
const categoryHref = scopeHref({ line: place.line.id, group: place.group.id, type: place.type?.id });
// The trail shown above the title: line, group, and type when there is one.
const trail = [
  { name: place.line.name, href: scopeHref({ line: place.line.id }) },
  { name: place.group.name, href: scopeHref({ line: place.line.id, group: place.group.id }) },
  ...(place.type
    ? [{ name: place.type.short, href: scopeHref({ line: place.line.id, group: place.group.id, type: place.type.id }) }]
    : []),
];

// Description: the facts a buyer would search for, then the frame, kept
// within ~155 characters so a search result shows it whole. The longest
// frame that fits is used; if the facts alone run long, they are cut at a
// comma, never mid-word.
const MAX_DESC = 155;
const factText = facts.map((f) => `${f.label.toLowerCase()} ${f.value}`).join(', ');
let lead = factText ? `${item.name}: ${factText}.` : `${item.name}.`;
if (lead.length > MAX_DESC) {
  const cut = lead.slice(0, MAX_DESC - 1);
  lead = `${cut.slice(0, Math.max(cut.lastIndexOf(','), item.name.length + 1))}.`;
}
const description =
  [
    " Sourced through MH PharmaPack's partner network, to your specification.",
    ' Sourced to your specification.',
    '',
  ]
    .map((frame) => lead + frame)
    .find((d) => d.length <= MAX_DESC) ?? lead;

// "Name | Pharma Packaging | MH PharmaPack" when that fits in 60 characters,
// else "Name | MH PharmaPack": search results cut titles at about 60.
const baseTitle = `${item.name} | MH PharmaPack`;
const title =
  placeOf(item).line.id === 'packaging' && baseTitle.length + 19 <= 60
    ? `${item.name} | Pharma Packaging | MH PharmaPack`
    : baseTitle;
---

<Base
  title={title}
  name={item.name}
  description={description}
  pageType="ItemPage"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'What We Source', path: '/capabilities' },
    { name: 'Catalogue', path: '/catalogue' },
    { name: item.name },
  ]}
>
  <section class="bg-paper">
    <div class="mx-auto max-w-content px-5 pt-6 pb-12 md:px-8 md:pt-10 md:pb-16">
      <a
        href={catalogueHref}
        data-cat-back
        class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-steel-deep transition-colors hover:text-ink"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m14.5 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to the catalogue
      </a>

      <div class="mt-4 grid gap-8 md:mt-6 md:grid-cols-[minmax(0,24rem)_1fr] md:gap-12 lg:grid-cols-[minmax(0,28rem)_1fr] lg:gap-16">
        <div>
          <figure class="m-0 flex aspect-square items-center justify-center overflow-hidden rounded-sm border border-line bg-white p-6 md:p-10">
            {
              item.illustrative ? (
                <img
                  src={imageFor(item.image).src}
                  alt={`${item.name}, representative illustration`}
                  class="h-full w-full scale-[1.32] object-contain"
                  decoding="async"
                />
              ) : (
                <Image
                  src={imageFor(item.image)}
                  alt={item.name}
                  width={600}
                  densities={[1, 2]}
                  format="webp"
                  quality={82}
                  class="h-full w-full object-contain"
                  loading="eager"
                />
              )
            }
          </figure>
          {item.credit && <p class="mt-2 text-xs leading-relaxed text-steel-deep">{item.credit}</p>}
        </div>

        <div>
          <nav aria-label="Catalogue section">
            <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0">
              {
                trail.map((t, i) => (
                  <li class="flex items-center gap-2">
                    {i > 0 && (
                      <span class="text-xs text-muted" aria-hidden="true">
                        /
                      </span>
                    )}
                    <a href={t.href} class="eyebrow hover:text-copper">
                      {t.name}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink md:text-4xl">{item.name}</h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-steel-deep">
            Sourced through our partner network and supplied to your specification: what we source,
            not what we make.
          </p>

          <dl class="mt-8 divide-y divide-line border-y border-line">
            {
              facts.map((f) => (
                <div class="grid grid-cols-[8.5rem_1fr] gap-4 py-3 text-sm md:grid-cols-[10rem_1fr]">
                  <dt class="font-semibold text-steel-deep">{f.label}</dt>
                  <dd class="m-0 text-ink">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          {note && <p class="mt-3 text-xs leading-relaxed text-steel-deep">{note}</p>}

          <div id="enquire" class="mt-10 scroll-mt-24 border-t border-line pt-8">
            <h2 class="text-xl font-bold tracking-tight text-ink">Enquire about this item</h2>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-steel-deep">
              Tell us the quantity, the destination market and the timeline, and we will come back
              with the right plant and a quote.
            </p>
            <div class="mt-5">
              <EnquiryActions item={item} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="border-t border-line bg-paper-warm">
        <div class="mx-auto max-w-content px-5 py-12 md:px-8 md:py-16">
          <p class="eyebrow">More in {place.group.name}</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-ink md:text-3xl">Related items.</h2>
          <ul class="mt-8 grid list-none grid-cols-2 gap-x-3 gap-y-6 p-0 sm:grid-cols-3 md:gap-x-4 lg:grid-cols-5">
            {related.map((r) => (
              <CatalogueCard item={r} />
            ))}
          </ul>
          <div class="mt-8">
            <a href={categoryHref} class="btn btn-secondary">
              All {category}
            </a>
          </div>
        </div>
      </section>
    )
  }

  <EnquiryTray />

  <script>
    // "Back to the catalogue" returns to the exact view the reader left
    // (see src/scripts/catalogue-return.ts). Without a recorded view, as
    // when this page was opened straight from an email, the link keeps its
    // plain href: the catalogue opened at this item's line.
    import { readReturn, writeReturn } from '../../scripts/catalogue-return';

    const link = document.querySelector<HTMLAnchorElement>('[data-cat-back]');
    const saved = readReturn();
    if (link && saved?.url) {
      link.href = saved.url;
      link.addEventListener('click', () => writeReturn({ ...saved, returning: true }));
    }
  </script>
</Base>
