---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import ScrollHero from '../components/ScrollHero.astro';
import { MAILTO_HREF, WHATSAPP_HREF, TEL_HREF, WHATSAPP, PHONE, withBase } from '../config';
import { sourcingService } from '../lib/seo';
import { SOURCING_LINES } from '../data/lines';

// Copy on this page is placed from CONTENT-SPEC.md section 4, updated for the
// client's change of 2026-09-23: three sourcing lines (API, Finished
// Formulations, Packaging) instead of five, and packaging named up front.
// Hero headline: recommended Option A. [NEEDS: final headline confirmation]
//
// The lines come from src/data/lines.ts, shared with every other page. The
// structured data names the lines only; their categories are printed in
// running sentences here, not as a list the markup could mirror.
const lines = SOURCING_LINES;

const steps = [
  {
    title: 'You tell us the requirement.',
    copy: 'Product, specification, quantity, market, and timeline.',
  },
  {
    title: 'We match the right plant.',
    copy: 'From our network of WHO GMP and EU GMP approved manufacturers across three regions.',
  },
  {
    title: 'We coordinate the deal.',
    copy: 'Supplier audit support, QA and QC and dossier coordination, documentation, payment terms, and logistics follow-up.',
  },
  {
    title: 'You deal directly with the manufacturer.',
    copy: 'Contracts of sale are between you and the plant. We make the introduction work and stay with it end to end.',
  },
];

// Title: category first, brand last. Nobody is searching the brand yet, so the
// first forty characters have to say what this is. "Pharmaceutical sourcing"
// and "India" are the two phrases a buyer actually types, and the descriptor is
// the same one carried in the header lockup, so the title, the hero eyebrow,
// and the nav anchor text all agree. That agreement is what stops Google
// substituting a title of its own.
//
// Description: written to survive truncation at roughly 155 characters, with
// the three sourcing lines and both approval standards in the first sentence,
// because that is the half that always shows.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Base
  title="Pharmaceutical Sourcing & Supply from India | MH PharmaPack"
  name="Pharmaceutical sourcing and supply"
  description="Sourcing API, finished formulations and pharmaceutical packaging from WHO GMP and EU GMP approved plants in India, Latin America and South Africa. Ahmedabad based."
  schema={[sourcingService(lines.map((l) => ({ name: l.name })), pageUrl, Astro.site)]}
>
  <!-- Logo intro overlay: home route only, once per session, reduced-motion safe -->
  <Intro slot="pre-shell" />

  <!-- 4.1 Hero: scroll-synced light-stream journey (dark navy band). The hero
       copy, beats, credential row, and CTAs all live inside the component.
       The page stays dark from here down and only turns to steel-white at the
       closing call to action. -->
  <ScrollHero />

  <!-- Post-hero flow: the handoff happens inside the hero's canvas (the
       world lightens and the river thins into the gutter); down here the
       thread rail and its station nodes track the sections while the
       canvas river flows along the same gutter. -->
  <div class="thread-scope" data-thread-scope>
  <div class="thread-line" data-thread-line aria-hidden="true"></div>

  <!-- 4.2 What we do, in one line each. This one keeps the hero's own fixed
       gradient rather than the flat band tone, so the seam where the strand
       runs down out of the canvas stays invisible. Every section below it
       uses the single flat .band tone instead. -->
  <section class="sec-deep" data-thread-station>
    <div class="mx-auto max-w-content px-5 pt-14 pb-16 md:px-8 md:pt-16 md:pb-24">
      <p class="eyebrow eyebrow-on-dark" data-reveal>What we do</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-paper md:text-4xl" data-reveal>
        Three sourcing lines, one point of contact.
      </h2>
      <div class="mt-12 grid gap-x-10 gap-y-10 md:grid-cols-3">
        {
          lines.map((line) => (
            <div data-reveal-child>
              <svg class="h-7 w-7 text-copper-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={line.icon} />
              <h3 class="mt-4 text-lg font-bold text-paper">{line.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-line md:text-base">{line.blurb}</p>
              {line.id === 'packaging' && (
                <a href={withBase('/catalogue')} class="mt-3 inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-copper-soft hover:text-paper">
                  Browse the packaging catalogue
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m10 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              )}
            </div>
          ))
        }
      </div>
      <p class="mt-12 max-w-2xl text-base leading-relaxed text-paper" data-reveal>
        Any one of these, or all three for a single programme, matched to the right approved plant
        and coordinated by us from first enquiry to delivered goods.{' '}<a href={withBase('/services')} class="font-semibold text-copper-soft underline underline-offset-4 hover:text-paper">What We Do</a>
      </p>
    </div>
  </section>

  <!-- 4.3 How it works. Flat band tone, like every section from here to the
       close except the credibility band. Told apart from its neighbours by the
       hairline above it, the copper numerals, and its own two-column list,
       never by a different shade of navy. -->
  <section class="band band-edge" data-thread-station>
    <div class="mx-auto max-w-content px-5 py-16 md:px-8 md:py-24">
      <p class="eyebrow eyebrow-on-dark" data-reveal>How it works</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-paper md:text-4xl" data-reveal>
        From requirement to delivered goods.
      </h2>
      <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:gap-x-8">
        {
          steps.map((step, i) => (
            <li class="border-t-2 border-hairline pt-5" data-reveal-child>
              <span class="station-num text-sm font-bold tracking-eyebrow text-copper-soft">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-bold text-paper">{step.title}</h3>
              <p class="mt-2 max-w-md text-base leading-relaxed text-mist">{step.copy}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4.4 Reach and quality, the credibility band. The weave texture is a
       faint static echo of the hero's streams; see .band-weave in global.css -->
  <!-- The one section lifted out of the navy run, and it does it by going
       light rather than by taking an accent colour (see the note in
       global.css: teal and bronze were both tried and both read as foreign
       objects). Paper is 12.7:1 against the navy either side, so the contrast
       alone carries it. Deeper padding than its neighbours and hairline edges
       top and bottom, so it reads as a deliberate inset rather than a slab
       dropped into the page. -->
  <section class="border-y border-line bg-paper band-weave-light" data-thread-station>
    <div class="relative mx-auto max-w-content px-5 py-20 md:px-8 md:py-28">
      <p class="eyebrow" data-reveal>Reach and quality</p>
      <!-- [NEEDS: confirm headline] Authored to match the section pattern; the
           spec gives 4.4 proof points but no heading. Says only what 4.4's own
           bullets say (three named regions, all approved), so it adds no claim. -->
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Approved plants across three regions.
      </h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        <div data-reveal-child>
          <h3 class="text-xs font-semibold tracking-eyebrow text-copper-deep uppercase">Sourcing regions</h3>
          <p class="mt-4 text-base leading-relaxed text-steel-deep">
            India, Latin America (EU approved), South Africa (WHO GMP, PIC/S approved).
          </p>
        </div>
        <div data-reveal-child>
          <h3 class="text-xs font-semibold tracking-eyebrow text-copper-deep uppercase">Quality standard</h3>
          <p class="mt-4 text-base leading-relaxed text-steel-deep">
            We source exclusively from WHO GMP and EU GMP approved facilities. Partner plants hold
            WHO GMP, EU GMP, ISO, and UK MHRA approvals.
          </p>
        </div>
        <div data-reveal-child>
          <h3 class="text-xs font-semibold tracking-eyebrow text-copper-deep uppercase">Network</h3>
          <!-- [NEEDS: confirm the public number] Using the spec's recommended qualitative phrasing. -->
          <p class="mt-4 text-base leading-relaxed text-steel-deep">
            A growing network of approved manufacturing partners.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4.5 Services strip. Quiet-statement pattern, shared with 4.6: eyebrow
       plus one large line, no heading, because the spec gives this section a
       single sentence and a heading would only restate it. -->
  <section class="band band-edge" data-thread-station>
    <div class="mx-auto max-w-content px-5 py-14 md:px-8 md:py-16">
      <p class="eyebrow eyebrow-on-dark" data-reveal>Services</p>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-paper" data-reveal>
        Beyond the match: supplier audit support, business development, QA and QC and dossier
        coordination, paperwork, payment terms, collection, and logistics follow-up.
        <a href={withBase('/services')} class="font-semibold text-copper-soft underline underline-offset-4 hover:text-paper">What We Do</a>
      </p>
    </div>
  </section>

  <!-- 4.6 Proof / reference case (anonymised default; named version only with written consent) -->
  <section class="band band-edge" data-thread-station>
    <div class="mx-auto max-w-content px-5 py-16 md:px-8 md:py-20">
      <p class="eyebrow eyebrow-on-dark" data-reveal>A recent engagement</p>
      <p class="mt-5 max-w-3xl border-l-2 border-copper pl-5 text-xl leading-relaxed font-medium text-paper md:text-2xl" data-reveal>
        We recently connected an EU-approved corticosteroid API supplier with a Mumbai-based
        formulation company, and coordinated the supply end to end.
      </p>
    </div>
  </section>

  <!-- 4.7 Closing call to action -->
  <!-- The page turns to steel-white here and stays that way through the
       footer: after a long dark run the close reads as daylight, and the
       copper button is the only saturated thing on a pale ground.
       No eyebrow by design; the spec calls this section simple. -->
  <section class="bg-paper" data-thread-station>
    <div class="mx-auto max-w-content px-5 py-20 text-center md:px-8 md:py-28">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Tell us what you need, and we will find the right plant.
      </h2>
      <div class="mt-9" data-reveal>
        <a href={withBase('/contact')} class="btn btn-primary">Request a Quote</a>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm font-semibold" data-reveal>
        <a
          href={WHATSAPP_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number to be added'}
        >
          WhatsApp
        </a>
        <a
          href={TEL_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={PHONE ? 'Call us' : 'Phone number to be added'}
        >
          Call
        </a>
        <a href={MAILTO_HREF} class="text-steel-deep transition-colors hover:text-ink">Email</a>
      </div>
    </div>
  </section>
  </div>

  <script>
    import initPageFlow from '../scripts/page-flow.js';
    initPageFlow();
  </script>
</Base>
