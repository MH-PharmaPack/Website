---
import Base from '../../layouts/Base.astro';
import logo from '../../assets/logo/mh-pharmapack-logo.svg';
import { PARTNERS, partnerWhatsApp, type Partner } from '../../data/leadership';
import { MAILTO_HREF, SALES_EMAIL, OFFICE_ADDRESS, MAPS_HREF, withBase } from '../../config';

// The page an NFC card tap opens. Two layouts, one document.
//
// NARROW (< 768px): the phone treatment. A single centred column on paper.
// This is the case that matters most, because a tap is always a phone, held by
// someone who met this partner ten seconds ago and wants to save them. Order is
// identity, then the one action they came for, then the bio.
//
// WIDE (>= 768px): a landscape card. The phone column stranded in a 1900px
// window read as a screenshot pasted onto a page, so wide screens instead get
// the proportions of the real thing: the printed visiting card is 88.9 x 50.8mm
// landscape (see visiting-card/card-data.json), so the page becomes a navy
// identity panel beside a paper face carrying everything actionable.
//
// Split by width, never by user agent. UA sniffing misreads tablets and resized
// desktop windows, and cannot resolve at build time on a static site, so it
// would ship a flash of the wrong layout.
//
// The slug is printed into physical cards. It can never change.
// See src/data/leadership.ts.

export function getStaticPaths() {
  return PARTNERS.map((p) => ({ params: { slug: p.slug }, props: { partner: p } }));
}

interface Props {
  partner: Partner;
}

const { partner } = Astro.props;
const vcardHref = withBase(`/leadership/${partner.slug}.vcf`);

const actionClass =
  'flex flex-col items-center gap-1.5 rounded-sm border border-line py-3 text-xs font-semibold text-steel-deep transition-colors hover:border-steel hover:text-ink md:flex-1';
---

<Base
  title={`${partner.name}, ${partner.title} | MH PharmaPack`}
  description={`${partner.name}, ${partner.title} at MH PharmaPack. ${partner.lead} Direct contact details and vCard.`}
>
  <!-- Paper on a phone so the card IS the screen; paper-warm on wide screens so
       the card reads as an object resting on a surface. -->
  <section class="bg-paper md:bg-paper-warm">
    <div class="mx-auto w-full max-w-md px-5 pt-10 pb-16 md:max-w-4xl md:px-8 md:pt-16 md:pb-24">
      <div
        class="md:grid md:grid-cols-[260px_1fr] md:overflow-hidden md:rounded-md md:border md:border-line md:bg-paper md:shadow-[0_18px_44px_rgba(28,38,52,0.10)] lg:grid-cols-[320px_1fr]"
      >
        <!-- ---------- identity ---------- -->
        <div class="md:flex md:flex-col md:justify-between md:bg-band md:p-8">
          <img
            src={logo.src}
            width={logo.width}
            height={logo.height}
            alt=""
            class="mx-auto h-12 w-auto md:mx-0 md:h-10"
          />

          <div class="mt-8 md:mt-0">
            {
              partner.photo ? (
                <img
                  src={partner.photo}
                  alt={`${partner.name}, ${partner.title} at MH PharmaPack`}
                  class="mx-auto h-32 w-32 rounded-sm object-cover md:mx-0 md:h-auto md:w-full md:aspect-[4/5]"
                />
              ) : (
                /* Real fallback, not a mockup device: the page ships and works
                   before the headshots land. [NEEDS: the two headshots] */
                <span
                  class="mx-auto flex h-32 w-32 items-center justify-center rounded-sm bg-band md:mx-0 md:h-auto md:w-full md:aspect-[4/5] md:bg-white/5 md:ring-1 md:ring-white/10"
                  aria-hidden="true"
                >
                  <span class="text-4xl font-bold tracking-widest text-copper-soft md:text-5xl">
                    {partner.initials}
                  </span>
                </span>
              )
            }

            <h1
              class="mt-5 text-center text-2xl font-bold tracking-tight text-ink md:mt-6 md:text-left md:text-3xl md:text-paper"
            >
              {partner.name}
            </h1>
            <p
              class="mt-1 text-center text-xs font-semibold tracking-eyebrow text-copper-deep uppercase md:mt-2 md:text-left md:text-copper-soft"
            >
              {partner.title}, MH PharmaPack
            </p>
          </div>

          <!-- Anchors the panel's foot on wide screens; the phone layout has no
               room for it and drops it. -->
          <p class="hidden md:mt-8 md:block md:text-[0.68rem] md:leading-relaxed md:text-mist">
            India &middot; Latin America &middot; South Africa
          </p>
        </div>

        <!-- ---------- actions and detail ---------- -->
        <div class="md:p-8">
          <!-- The one action this page exists for. copper-deep rather than the
               lighter copper: it reads as copper instead of orange, and lifts
               white text from 4.51:1 to 7.55:1 at the same time. -->
          <div class="mt-8 md:mt-0 md:flex md:items-stretch md:gap-2.5">
            <a
              href={vcardHref}
              download={`${partner.slug}.vcf`}
              class="flex min-h-13 w-full items-center justify-center gap-2.5 rounded-sm bg-copper-deep px-5 text-base font-semibold text-white transition-colors hover:bg-copper md:w-auto md:min-w-[15rem] md:flex-none"
            >
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 3v11" stroke-linecap="round"></path>
                <path d="m7.5 10.5 4.5 4.5 4.5-4.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M4.5 16.5v2.25A1.25 1.25 0 0 0 5.75 20h12.5a1.25 1.25 0 0 0 1.25-1.25V16.5" stroke-linecap="round"></path>
              </svg>
              Save to contacts
            </a>

            <!-- Stacked under the button on a phone, inline beside it on a wide
                 screen, so the whole action set is one row. -->
            <div class="mt-2 grid grid-cols-3 gap-2 md:mt-0 md:flex md:flex-1 md:gap-2.5">
              <a href={`tel:${partner.phone}`} class={actionClass}>
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M5.1 4.5h3l1.4 3.6-1.8 1.4a11.3 11.3 0 0 0 4.8 4.8l1.4-1.8 3.6 1.4v3a1.5 1.5 0 0 1-1.6 1.5C9.6 18 6 14.4 5.6 8.1 5.5 6 4.9 5.6 5.1 4.5Z" stroke-linejoin="round"></path>
                </svg>
                Call
              </a>
              <a href={partnerWhatsApp(partner)} target="_blank" rel="noopener noreferrer" class={actionClass}>
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M12 3.75a8.25 8.25 0 0 0-7.1 12.45L3.75 20.25l4.2-1.1A8.25 8.25 0 1 0 12 3.75Z" stroke-linejoin="round"></path>
                </svg>
                WhatsApp
              </a>
              <a href={MAILTO_HREF} class={actionClass}>
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="3.4" y="5.4" width="17.2" height="13.2" rx="1.6"></rect>
                  <path d="m3.9 6.4 8.1 6 8.1-6" stroke-linejoin="round"></path>
                </svg>
                Email
              </a>
            </div>
          </div>

          <!-- Written out too, because a number you can read is a number you can
               dictate to someone else. Right-aligned on a phone to sit opposite
               its label; left-aligned in the wide card where there is room. -->
          <dl class="mt-8 border-t border-line pt-6 text-sm md:mt-9 md:pt-7">
            <div class="flex justify-between gap-4 py-1.5 md:justify-start md:gap-8">
              <dt class="text-muted md:w-24 md:shrink-0">Direct</dt>
              <dd>
                <a href={`tel:${partner.phone}`} class="font-medium text-steel-deep hover:text-ink">
                  {partner.phoneDisplay}
                </a>
              </dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 md:justify-start md:gap-8">
              <dt class="text-muted md:w-24 md:shrink-0">Email</dt>
              <dd>
                <a href={MAILTO_HREF} class="font-medium text-steel-deep hover:text-ink">{SALES_EMAIL}</a>
              </dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 md:justify-start md:gap-8">
              <dt class="shrink-0 text-muted md:w-24">Office</dt>
              <dd class="text-right md:text-left">
                <a
                  href={MAPS_HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-steel-deep hover:text-ink"
                >
                  {OFFICE_ADDRESS}
                </a>
              </dd>
            </div>
          </dl>

          <!-- Bio last on purpose: wanted least by the person who just tapped,
               and still wanted by anyone who arrived by browsing. -->
          <div class="mt-8 border-t border-line pt-6 md:mt-9 md:pt-7">
            <p class="text-xs font-semibold tracking-eyebrow text-muted uppercase">About</p>
            {
              partner.bio ? (
                <p class="mt-3 max-w-prose text-sm leading-relaxed text-steel-deep">{partner.bio}</p>
              ) : (
                <p class="mt-3 max-w-prose text-sm leading-relaxed text-steel-deep">
                  {partner.title} at MH PharmaPack. {partner.lead}
                  <span class="placeholder-note mt-2 block text-xs">
                    [Bio pending: years in the trade, prior companies, languages spoken.]
                  </span>
                </p>
              )
            }
            {
              partner.linkedin && (
                <a
                  href={partner.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-block text-sm font-semibold text-copper-deep underline underline-offset-4 hover:text-copper"
                >
                  LinkedIn
                </a>
              )
            }
          </div>
        </div>
      </div>

      <a
        href={withBase('/leadership')}
        class="mt-10 inline-block text-sm font-semibold text-copper-deep underline underline-offset-4 hover:text-copper"
      >
        &lsaquo; Leadership
      </a>
    </div>
  </section>
</Base>
