---
import Base from '../../layouts/Base.astro';
// Build-time resized logo (see Header.astro): shown at 48 CSS px here.
import { Image } from 'astro:assets';
import logo from '../../assets/logo/mh-pharmapack-logo.webp';
import { PARTNERS, partnerWhatsApp, type Partner } from '../../data/leadership';
import {
  MAILTO_HREF,
  SALES_EMAIL,
  OFFICE_ADDRESS,
  OFFICE_ADDRESS_PARTS,
  MAPS_HREF,
  withBase,
} from '../../config';
import { ORG_ID, abs } from '../../lib/seo';

// The page an NFC card tap opens. Two layouts, one document.
//
// NARROW (< 768px): the phone treatment. A single centred column on paper.
// This is the case that matters most, because a tap is always a phone, held by
// someone who met this partner ten seconds ago and wants to save them. Order is
// identity, then the one action they came for, then the bio.
//
// WIDE (>= 768px): a full-bleed navy band carrying the identity, then the
// actions, details and bio on paper below it, two up. Client's choice from a
// four-way study on 2026-08-10.
//
// Why a band and not a side panel. Every side-panel version leaves slack
// somewhere on a wide window: a fixed panel strands empty paper to the right of
// the copy, a percentage panel inflates the portrait until the page will not
// fit on screen, and a centred split leaves a hole down the middle. Both of
// those were built and rejected. A band has no such failure mode, because the
// navy is happy to be any width and everything inside it sits on the same
// 1180px grid as the header, the footer and every other page. Two earlier
// wide-screen attempts (a landscape card, then the fixed-panel split) are gone.
//
// Split by width, never by user agent. UA sniffing misreads tablets and resized
// desktop windows, and cannot resolve at build time on a static site, so it
// would ship a flash of the wrong layout.
//
// The slug is printed into physical cards. It can never change.
// See src/data/leadership.ts.

export function getStaticPaths() {
  return PARTNERS.map((p) => ({ params: { slug: p.slug }, props: { partner: p } }));
}

interface Props {
  partner: Partner;
}

const { partner } = Astro.props;
const vcardHref = withBase(`/leadership/${partner.slug}.vcf`);

// The Person node this page is about, tied to the organisation by @id so the
// two are one graph rather than two unrelated claims. No rich result comes of
// this; it is entity disambiguation, which is the part that matters when the
// name is as common as these two are.
const personId = `${abs(`/leadership/${partner.slug}`, Astro.site)}#person`;
const personNode = {
  '@type': 'Person',
  '@id': personId,
  name: partner.name,
  jobTitle: partner.title,
  worksFor: { '@id': ORG_ID },
  description: partner.bio || `${partner.title} at MH PharmaPack. ${partner.lead}`,
  telephone: partner.phone,
  email: SALES_EMAIL,
  workLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: OFFICE_ADDRESS_PARTS.street,
      addressLocality: OFFICE_ADDRESS_PARTS.city,
      addressRegion: OFFICE_ADDRESS_PARTS.region,
      postalCode: OFFICE_ADDRESS_PARTS.postcode,
      addressCountry: 'IN',
    },
  },
  // Only real profiles. An invented LinkedIn URL is worse than none: it teaches
  // the crawler that this site's identity claims do not resolve.
  ...(partner.linkedin ? { sameAs: [partner.linkedin] } : {}),
};

const actionClass =
  'flex flex-col items-center gap-1.5 rounded-sm border border-line py-3 text-xs font-semibold text-steel-deep transition-colors hover:border-steel hover:text-ink xl:flex-1';

const backClass =
  'text-sm font-semibold text-copper-deep underline underline-offset-4 hover:text-copper';
---

<Base
  title={`${partner.name}, ${partner.title} | MH PharmaPack`}
  name={partner.name}
  description={`${partner.name}, ${partner.title} at MH PharmaPack, pharmaceutical sourcing and supply in Ahmedabad. ${partner.lead} Direct line, WhatsApp, and vCard.`}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Leadership', path: '/leadership' },
    { name: partner.name },
  ]}
  schema={[personNode]}
  mainEntityId={personId}
>
  <!-- bg-paper lives on the section, never on the band itself: .panel-deep is a
       component-layer rule and any bg-* utility on the same element would
       outrank it at every width, navy included. The band is simply transparent
       below 768px and lets this paper through. -->
  <section class="bg-paper">
    <!-- ---------- identity ----------
         A plain column on a phone; a full-bleed navy band on wide screens,
         with its contents on the site's own content grid. -->
    <div class="panel-deep">
      <div class="mx-auto w-full max-w-md px-5 pt-10 md:max-w-content md:px-8 md:py-12">
        <div class="md:flex md:items-center md:gap-10 lg:gap-12">
          <!-- Phone only. On a wide screen the site header sits directly above
               this band with the full lockup in it, so a second bare mark two
               centimetres below it read as a stray. -->
          <Image src={logo} height={144} quality={82} alt="" class="mx-auto h-12 w-auto md:hidden" />

          <div class="mt-8 md:mt-0 md:w-56 md:shrink-0">
            {
              partner.photo ? (
                <img
                  src={partner.photo}
                  alt={`${partner.name}, ${partner.title} at MH PharmaPack`}
                  class="mx-auto h-32 w-32 rounded-sm object-cover md:h-auto md:w-full md:aspect-[4/5]"
                />
              ) : (
                /* Real fallback, not a mockup device: the page ships and works
                   before the headshots land. [NEEDS: the two headshots] */
                <span
                  class="mx-auto flex h-32 w-32 items-center justify-center rounded-sm bg-band md:h-auto md:w-full md:aspect-[4/5] md:bg-white/5 md:ring-1 md:ring-white/10"
                  aria-hidden="true"
                >
                  <span class="text-4xl font-bold tracking-widest text-copper-soft md:text-5xl">
                    {partner.initials}
                  </span>
                </span>
              )
            }
          </div>

          <div class="md:min-w-0">
            <h1
              class="mt-5 text-center text-2xl font-bold tracking-tight text-ink md:mt-0 md:text-left md:text-3xl md:text-paper"
            >
              {partner.name}
            </h1>
            <p
              class="mt-1 text-center text-xs font-semibold tracking-eyebrow text-copper-deep uppercase md:mt-2 md:text-left md:text-copper-soft"
            >
              {partner.title}, MH PharmaPack
            </p>
            <!-- No room for this on a phone, so it is dropped there. -->
            <p class="hidden md:mt-6 md:block md:text-[0.68rem] md:leading-relaxed md:text-mist">
              India &middot; Latin America &middot; South Africa
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ---------- actions and detail ---------- -->
    <div class="mx-auto w-full max-w-md px-5 pt-8 pb-16 md:max-w-content md:px-8 md:py-12">
      <!-- Wide screens get the way out here, above the fold. The phone keeps
           its approved copy at the very bottom of the page. -->
      <a href={withBase('/leadership')} class={`hidden md:mb-10 md:inline-block ${backClass}`}>
        &lsaquo; Leadership
      </a>

      <!-- Two up from lg. Below that it is a single column, capped so the
           save button does not stretch to the full 1180px band on a tablet. -->
      <div class="md:max-w-2xl lg:grid lg:max-w-none lg:grid-cols-2 lg:gap-16">
        <div>
          <!-- The one action this page exists for. copper-deep rather than the
               lighter copper: it reads as copper instead of orange, and lifts
               white text from 4.51:1 to 7.55:1 at the same time. -->
          <!-- All four abreast only from xl. In a half column at lg the three
               secondary buttons get about 59px each and WhatsApp stops
               fitting, so they stay stacked under the button until then. -->
          <div class="xl:flex xl:items-stretch xl:gap-2.5">
            <a
              href={vcardHref}
              download={`${partner.slug}.vcf`}
              class="flex min-h-13 w-full items-center justify-center gap-2.5 rounded-sm bg-copper-deep px-5 text-base font-semibold text-white transition-colors hover:bg-copper xl:w-auto xl:min-w-[15rem] xl:flex-none"
            >
              <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 3v11" stroke-linecap="round"></path>
                <path d="m7.5 10.5 4.5 4.5 4.5-4.5" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M4.5 16.5v2.25A1.25 1.25 0 0 0 5.75 20h12.5a1.25 1.25 0 0 0 1.25-1.25V16.5" stroke-linecap="round"></path>
              </svg>
              Save to contacts
            </a>

            <!-- Stacked under the button on a phone, inline beside it once
                 there is room, so the whole action set is one row. -->
            <div class="mt-2 grid grid-cols-3 gap-2 xl:mt-0 xl:flex xl:flex-1 xl:gap-2.5">
              <a href={`tel:${partner.phone}`} class={actionClass}>
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M5.1 4.5h3l1.4 3.6-1.8 1.4a11.3 11.3 0 0 0 4.8 4.8l1.4-1.8 3.6 1.4v3a1.5 1.5 0 0 1-1.6 1.5C9.6 18 6 14.4 5.6 8.1 5.5 6 4.9 5.6 5.1 4.5Z" stroke-linejoin="round"></path>
                </svg>
                Call
              </a>
              <a href={partnerWhatsApp(partner)} target="_blank" rel="noopener noreferrer" class={actionClass}>
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <path d="M12 3.75a8.25 8.25 0 0 0-7.1 12.45L3.75 20.25l4.2-1.1A8.25 8.25 0 1 0 12 3.75Z" stroke-linejoin="round"></path>
                </svg>
                WhatsApp
              </a>
              <a href={MAILTO_HREF} class={actionClass}>
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <rect x="3.4" y="5.4" width="17.2" height="13.2" rx="1.6"></rect>
                  <path d="m3.9 6.4 8.1 6 8.1-6" stroke-linejoin="round"></path>
                </svg>
                Email
              </a>
            </div>
          </div>

          <!-- Written out too, because a number you can read is a number you
               can dictate to someone else. Right-aligned on a phone to sit
               opposite its label; left-aligned where there is room. -->
          <dl class="mt-8 border-t border-line pt-6 text-sm md:mt-9 md:pt-7">
            <div class="flex justify-between gap-4 py-1.5 md:justify-start md:gap-8">
              <dt class="text-muted md:w-24 md:shrink-0">Direct</dt>
              <dd>
                <a href={`tel:${partner.phone}`} class="font-medium text-steel-deep hover:text-ink">
                  {partner.phoneDisplay}
                </a>
              </dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 md:justify-start md:gap-8">
              <dt class="text-muted md:w-24 md:shrink-0">Email</dt>
              <dd>
                <a href={MAILTO_HREF} class="font-medium text-steel-deep hover:text-ink">{SALES_EMAIL}</a>
              </dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 md:justify-start md:gap-8">
              <dt class="shrink-0 text-muted md:w-24">Office</dt>
              <dd class="text-right md:text-left">
                <a
                  href={MAPS_HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-steel-deep hover:text-ink"
                >
                  {OFFICE_ADDRESS}
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <!-- Bio last on purpose: wanted least by the person who just tapped,
             and still wanted by anyone who arrived by browsing. It loses its
             separating rule once it is a column of its own rather than the
             next thing down the page. -->
        <div class="mt-8 border-t border-line pt-6 md:mt-9 md:pt-7 lg:mt-0 lg:border-t-0 lg:pt-0">
          <p class="text-xs font-semibold tracking-eyebrow text-muted uppercase">About</p>
          {
            partner.bio ? (
              <p class="mt-3 max-w-prose text-sm leading-relaxed text-steel-deep">{partner.bio}</p>
            ) : (
              <p class="mt-3 max-w-prose text-sm leading-relaxed text-steel-deep">
                {partner.title} at MH PharmaPack. {partner.lead}
                <span class="placeholder-note mt-2 block text-xs">
                  [Bio pending: years in the trade, prior companies, languages spoken.]
                </span>
              </p>
            )
          }
          {
            partner.linkedin && (
              <a
                href={partner.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-sm font-semibold text-copper-deep underline underline-offset-4 hover:text-copper"
              >
                LinkedIn
              </a>
            )
          }
        </div>
      </div>

      <a href={withBase('/leadership')} class={`mt-10 inline-block md:hidden ${backClass}`}>
        &lsaquo; Leadership
      </a>
    </div>
  </section>
</Base>
