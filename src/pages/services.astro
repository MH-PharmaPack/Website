---
import Base from '../layouts/Base.astro';
import { MAILTO_HREF, WHATSAPP_HREF, TEL_HREF, WHATSAPP, PHONE, withBase } from '../config';
import { sourcingService } from '../lib/seo';
import { SOURCING_LINES } from '../data/lines';

// WHAT WE DO (CONTENT-SPEC section 5), restructured 2026-09-23 at the
// client's direction: the three sourcing lines, then how an order is carried
// end to end with the support MH gives at each stage, then how quality is
// handled.
//
// Sources for every sentence:
//   intro paragraph            CONTENT-SPEC 5.1, verbatim
//   the three lines            src/data/lines.ts
//   stage copy                 CONTENT-SPEC 4.3 where it exists; stage
//                              titles 3 and 5 and their lines are authored
//                              [NEEDS: confirm copy]
//   support descriptions       CONTENT-SPEC 5.3, verbatim
//   the qualifier              CONTENT-SPEC 5.3, verbatim, mandatory
//   quality statements         CONTENT-SPEC 6.4 and 4.4, verbatim
//
// Guardrails that bite on this page in particular: MH coordinates and
// supports, it never certifies or assumes responsibility (guardrail 4, and
// the 5.3 qualifier); the approvals belong to the partner plants
// (guardrail 2), so no badge row.

const lines = SOURCING_LINES;

interface Support {
  name: string;
  copy: string;
}
interface Stage {
  phase: string;
  title: string;
  copy: string;
  support: Support[];
}

const stages: Stage[] = [
  {
    phase: 'Before the order',
    title: 'You tell us the requirement.',
    copy: 'Product, specification, quantity, market, and timeline.',
    support: [{ name: 'Business development', copy: 'Matching demand to the right supply, and supply to demand.' }],
  },
  {
    phase: 'Before the order',
    title: 'We match the right plant.',
    copy: 'From our network of WHO GMP and EU GMP approved manufacturers across three regions.',
    support: [{ name: 'Supplier audit support', copy: 'Help evaluating and qualifying manufacturers.' }],
  },
  {
    phase: 'During the order',
    title: 'We coordinate quality and paperwork.',
    copy: 'Quality documentation, dossiers, and trade paperwork move between you and the plant through one point of contact.',
    support: [
      {
        name: 'QA / QC and dossier coordination',
        copy: 'Coordinating quality documentation and dossiers between the parties.',
      },
      { name: 'Documentation and paperwork', copy: 'Support with the trade paperwork a deal requires.' },
    ],
  },
  {
    phase: 'During the order',
    title: 'You deal directly with the manufacturer.',
    copy: 'Contracts of sale are between you and the plant. We make the introduction work and stay with it end to end.',
    support: [
      { name: 'Payment terms', copy: 'Helping structure workable commercial terms between buyer and supplier.' },
    ],
  },
  {
    phase: 'Through delivery',
    title: 'We stay with it until it lands.',
    copy: 'From collection at the plant to arrival in your market, one point of contact follows the shipment.',
    support: [
      {
        name: 'Collection and logistics follow-up',
        copy: 'Staying with the shipment, chasing, and troubleshooting until it lands.',
      },
    ],
  },
];

const quality = [
  {
    title: 'Approved plants only',
    copy: 'We source exclusively from WHO GMP and EU GMP approved plants. Our partner facilities hold WHO GMP, EU GMP, ISO, and UK MHRA approvals.',
  },
  {
    title: 'Plants evaluated before you commit',
    copy: 'Supplier audit support: help evaluating and qualifying manufacturers, before an order is placed.',
  },
  {
    title: 'Quality documentation, coordinated',
    copy: 'We coordinate quality documentation and dossiers between buyer and supplier. Coordination, not certification: the approvals belong to the manufacturing partners.',
  },
];

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Base
  title="What We Do: End-to-End Pharmaceutical Sourcing | MH PharmaPack"
  name="What we do"
  description="We source API, finished formulations and pharmaceutical packaging from WHO GMP and EU GMP approved plants, and support every order end to end: supplier audits, QA and dossier coordination, paperwork, payment terms and logistics."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'What We Do' }]}
  schema={[sourcingService(lines.map((l) => ({ name: l.name, items: l.categories })), pageUrl, Astro.site)]}
  mainEntityId={`${pageUrl}#service`}
>
  <!-- 5.1 Intro. Paragraph verbatim; headline authored. [NEEDS: confirm headline] -->
  <section class="bg-paper">
    <div class="mx-auto max-w-content px-5 pt-12 pb-10 md:px-8 md:pt-16 md:pb-14">
      <p class="eyebrow" data-reveal>What we do</p>
      <h1 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Pharmaceutical sourcing, carried end to end.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-steel-deep" data-reveal>
        MH PharmaPack is a sourcing and supply partner for the pharmaceutical industry. We connect you
        with the right approved manufacturer and coordinate the entire engagement. We do not
        manufacture; we source, match, and manage, so a single point of contact carries your
        requirement from first enquiry to delivered goods.
      </p>
      <div class="mt-7 flex flex-wrap gap-3" data-reveal>
        <a href={withBase('/contact')} class="btn btn-primary">Request a Quote</a>
        <a href={withBase('/catalogue')} class="btn btn-secondary">Browse the catalogue</a>
      </div>
    </div>
  </section>

  <!-- 5.2 The three lines -->
  <section class="border-t border-line bg-paper">
    <div class="mx-auto max-w-content px-5 py-12 md:px-8 md:py-16">
      <p class="eyebrow" data-reveal>What we source</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Three sourcing lines.
      </h2>
      <ul class="line-cards mt-8 md:mt-10">
        {
          lines.map((line) => (
            <li class="line-card" data-reveal-child>
              <svg class="h-7 w-7 text-copper-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={line.icon} />
              <h3 class="mt-4 text-xl font-bold tracking-tight text-ink">{line.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-steel-deep">{line.summary}</p>
              <ul class="line-cats" aria-label={`${line.name} categories`}>
                {line.categories.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              {line.note && <p class="mt-3 text-sm text-steel-deep">{line.note}</p>}
              {line.id === 'packaging' ? (
                <a href={withBase('/catalogue')} class="line-link">
                  Browse the catalogue
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m10 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ) : (
                <a href={withBase('/contact')} class="line-link">
                  Request a Quote
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m10 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-2xl text-base leading-relaxed text-steel-deep" data-reveal>
        Any one of these, or all three for a single programme, matched to the right approved plant
        and coordinated by us.
      </p>
    </div>
  </section>

  <!-- 5.3 How we support every engagement: the order from requirement to
       delivery, and the support at each stage. Title from the spec's own
       wording. -->
  <section class="band band-edge">
    <div class="mx-auto max-w-content px-5 py-14 md:px-8 md:py-20">
      <p class="eyebrow eyebrow-on-dark" data-reveal>End to end</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-paper md:text-4xl" data-reveal>
        How we support every engagement.
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist" data-reveal>
        One point of contact from first enquiry to delivered goods, and the support we give at each
        stage of the order.
      </p>

      <ol class="stages mt-10 md:mt-14">
        {
          stages.map((s, i) => (
            <li class="stage" data-reveal-child>
              <span class="stage-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="stage-main">
                <p class="stage-phase">{s.phase}</p>
                <h3 class="stage-title">{s.title}</h3>
                <p class="stage-copy">{s.copy}</p>
              </div>
              <div class="stage-support">
                <p class="stage-support-h">Our support</p>
                {s.support.map((sp) => (
                  <div class="support">
                    <h4>{sp.name}</h4>
                    <p>{sp.copy}</p>
                  </div>
                ))}
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Mandatory, verbatim (CONTENT-SPEC 5.3) -->
      <p class="qualifier" data-reveal>
        We coordinate and support; we do not assume the manufacturer's regulatory or quality
        responsibilities, and contracts of sale are directly between buyer and supplier.
      </p>
    </div>
  </section>

  <!-- Quality: how it is handled. Attribution-safe throughout (guardrail 2).
       Heading authored. [NEEDS: confirm headline] -->
  <section class="border-b border-line bg-paper band-weave-light">
    <div class="relative mx-auto max-w-content px-5 py-16 md:px-8 md:py-24">
      <p class="eyebrow" data-reveal>Quality</p>
      <h2 class="mt-4 max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        How quality is handled.
      </h2>
      <div class="mt-10 grid gap-8 md:mt-12 md:grid-cols-3 md:gap-8">
        {
          quality.map((q) => (
            <div class="border-t-2 border-copper pt-5" data-reveal-child>
              <h3 class="text-lg font-bold tracking-tight text-ink">{q.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-steel-deep">{q.copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA (CONTENT-SPEC 5.4) -->
  <section class="bg-paper">
    <div class="mx-auto max-w-content px-5 py-20 text-center md:px-8 md:py-28">
      <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-ink md:text-4xl" data-reveal>
        Tell us what you need, and we will find the right plant.
      </h2>
      <div class="mt-9" data-reveal>
        <a href={withBase('/contact')} class="btn btn-primary">Request a Quote</a>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm font-semibold" data-reveal>
        <a
          href={WHATSAPP_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={WHATSAPP ? 'Chat on WhatsApp' : 'WhatsApp number to be added'}
        >
          WhatsApp
        </a>
        <a
          href={TEL_HREF}
          class="text-steel-deep transition-colors hover:text-ink"
          title={PHONE ? 'Call us' : 'Phone number to be added'}
        >
          Call
        </a>
        <a href={MAILTO_HREF} class="text-steel-deep transition-colors hover:text-ink">Email</a>
      </div>
    </div>
  </section>

  <style>
    /* ---- Line cards --------------------------------------------------- */
    /* No margin here: the mt-* utilities on the element set it, and a scoped
       rule would out-rank them. */
    .line-cards {
      display: grid;
      gap: 0.875rem;
      padding: 0;
      list-style: none;
    }
    @media (min-width: 768px) {
      .line-cards {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
      }
    }
    .line-card {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
      border: 1px solid var(--color-line);
      border-radius: 0.375rem;
      background: #ffffff;
    }
    .line-cats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 1rem 0 0;
      padding: 0;
      list-style: none;
    }
    .line-cats li {
      padding: 0.3rem 0.65rem;
      border: 1px solid var(--color-line);
      border-radius: 999px;
      background: var(--color-paper);
      color: var(--color-steel-deep);
      font-size: 0.8125rem;
    }
    .line-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-top: auto;
      padding-top: 1rem;
      min-height: 2.75rem;
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--color-copper-deep);
      text-decoration: none;
    }
    .line-link:hover {
      color: var(--color-copper);
    }

    /* ---- Stages ------------------------------------------------------- */
    /* Phone: a numbered rail down the left, the stage and its support
       stacked beside it. Desktop: three columns per stage (number, what
       happens, our support), rows ruled by hairlines. */
    .stages {
      padding: 0;
      list-style: none;
    }
    .stage {
      position: relative;
      display: grid;
      grid-template-columns: 2.75rem minmax(0, 1fr);
      column-gap: 1rem;
      padding-bottom: 2rem;
    }
    .stage::before {
      content: '';
      position: absolute;
      top: 2.9rem;
      bottom: 0.35rem;
      left: 1.375rem;
      width: 1px;
      background: var(--color-hairline);
    }
    .stage:last-child {
      padding-bottom: 0;
    }
    .stage:last-child::before {
      display: none;
    }
    .stage-num {
      grid-row: 1 / span 2;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid rgba(224, 176, 135, 0.45);
      border-radius: 999px;
      color: var(--color-copper-soft);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.06em;
    }
    .stage-phase {
      margin: 0.55rem 0 0;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-copper-soft);
    }
    .stage-title {
      margin-top: 0.35rem;
      font-size: 1.125rem;
      font-weight: 700;
      line-height: 1.3;
      color: var(--color-paper);
    }
    .stage-copy {
      margin-top: 0.4rem;
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--color-mist);
    }
    .stage-support {
      grid-column: 2;
      margin-top: 1rem;
      padding: 1rem 1.1rem;
      border: 1px solid var(--color-hairline);
      border-radius: 0.375rem;
      background: rgba(255, 255, 255, 0.03);
    }
    .stage-support-h {
      margin: 0;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-mist);
    }
    .support + .support {
      margin-top: 0.85rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--color-hairline);
    }
    .support h4 {
      margin-top: 0.5rem;
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--color-paper);
    }
    .support + .support h4 {
      margin-top: 0;
    }
    .support p {
      margin-top: 0.25rem;
      font-size: 0.875rem;
      line-height: 1.55;
      color: var(--color-mist);
    }
    @media (min-width: 900px) {
      .stage {
        grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 22rem);
        column-gap: 2rem;
        align-items: start;
        padding: 1.75rem 0;
        border-top: 1px solid var(--color-hairline);
      }
      .stage:last-child {
        padding-bottom: 1.75rem;
        border-bottom: 1px solid var(--color-hairline);
      }
      .stage::before {
        display: none;
      }
      .stage-num {
        grid-row: auto;
        width: 3rem;
        height: 3rem;
      }
      .stage-phase {
        margin-top: 0;
      }
      .stage-title {
        font-size: 1.3rem;
      }
      .stage-copy {
        max-width: 32rem;
        font-size: 1rem;
      }
      .stage-support {
        grid-column: 3;
        margin-top: 0;
      }
    }

    .qualifier {
      margin-top: 2.5rem;
      max-width: 48rem;
      padding-left: 1.1rem;
      border-left: 2px solid var(--color-copper-soft);
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--color-paper);
    }
  </style>

  <script>
    import initPageFlow from '../scripts/page-flow.js';
    initPageFlow();
  </script>
</Base>
